                                            <a href="/courses/course-detail/{{this.id}}"
                                                class="btn btn-outline-primary btn-sm flex-fill">Xem chi tiết</a>
                                            <form action="/courses/purchase-courses-process/{{this.id}}" method="POST"
                                                class="flex-fill">
                                                <button type="submit" class="btn btn-primary btn-sm w-100">Mua
                                                    ngay</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                    {{/if}}
                </div>

                {{#if pages.length}}
                <nav class="mt-4 d-flex justify-content-center">
                    <ul class="pagination" style="gap:8px;">
                        {{#if hasPrev}}
                        <li class="page-item">
                            {{!-- Sửa href: Thêm ../ và bỏ else --}}
                            <a class="page-link"
                                href="?page={{prevPage}}{{#if ../q}}&q={{../q}}{{/if}}{{#if ../selectedCategory}}&category={{../selectedCategory}}{{/if}}{{#if ../selectedSort}}&sort={{../selectedSort}}{{/if}}"
                                style="border:none;border-radius:50%;width:42px;height:42px;
                  display:flex;align-items:center;justify-content:center;
                  color:#007bff;box-shadow:0 2px 6px rgba(0,0,0,0.1);font-weight:500;">
                                &laquo;
                            </a>
                        </li>
                        {{/if}}

                        {{#each pages}}
                        <li class="page-item {{#if this.active}}active{{/if}}">
                            {{!-- Sửa href: Thêm ../ và bỏ else --}}
                            <a class="page-link"
                                href="?page={{this.number}}{{#if ../q}}&q={{../q}}{{/if}}{{#if ../selectedCategory}}&category={{../selectedCategory}}{{/if}}{{#if ../selectedSort}}&sort={{../selectedSort}}{{/if}}"
                                style="border:none;border-radius:50%;width:42px;height:42px;
                  display:flex;align-items:center;justify-content:center;
                  font-weight:500;
                  {{#if this.active}}
                    background-color:#007bff;color:white;box-shadow:0 0 8px rgba(0,123,255,0.4);
                  {{else}}
                    color:#007bff;
                  {{/if}}">
                                {{this.number}}
                            </a>
                        </li>
                        {{/each}}

                        {{#if hasNext}}
                        <li class="page-item">
                            <a class="page-link"
                                href="?page={{nextPage}}{{#if ../q}}&q={{../q}}{{/if}}{{#if ../selectedCategory}}&category={{../selectedCategory}}{{/if}}{{#if ../selectedSort}}&sort={{../selectedSort}}{{/if}}"
                                style="border:none;border-radius:50%;width:42px;height:42px;
                  display:flex;align-items:center;justify-content:center;
                  color:#007bff;box-shadow:0 2px 6px rgba(0,0,0,0.1);font-weight:500;">
                                &raquo;
                            </a>
                        </li>
                        {{/if}}
                    </ul>
                </nav>
                {{/if}}
                {{#unless courses}}
                {{#unless list}}
                <div class="text-center py-5">
                    <div class="empty-state">
                        <i class="bi bi-book display-1 text-muted mb-4"></i>
                        <h4 class="text-muted mb-3">Không tìm thấy khóa học</h4>
                        <p class="text-muted mb-4">Hãy thử điều chỉnh bộ lọc hoặc tìm kiếm với từ khóa khác</p>
                        <a href="/courses/view-courses" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-arrow-clockwise me-2"></i>Xem tất cả khóa học
                        </a>
                    </div>
                </div>
                {{/unless}}
                {{/unless}}
            </div>


        </div>
    </div>
</section>