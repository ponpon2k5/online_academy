{{!-- ========================= JS ========================= --}}
{{#section "js"}}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // 1) Khóa nút + spinner khi submit form Purchase (để tránh bấm 2 lần)
    document.addEventListener('submit', function (e) {
        const form = e.target;
        if (form.matches('form[action^="/courses/purchase-courses-process/"]')) {
            const btn = form.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `
          <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
          Đang xử lý...
        `;
            }
        }
    });

    // 2) Đọc query ?toast=...&msg=... để hiện thông báo sau khi server redirect
    (function showToastFromQuery() {
        const params = new URLSearchParams(location.search);
        const toast = params.get('toast'); // success | error | warning | info
        const msg = params.get('msg');

        if (toast && msg) {
            Swal.fire({
                icon: toast,
                title: toast === 'success' ? 'Thành công!' : (toast === 'error' ? 'Lỗi!' : 'Thông báo'),
                text: msg
            });
            // Xóa query để F5 không hiện lại
            history.replaceState(null, '', location.pathname);
        }
    })();

    // 3) Chuyển đổi Grid/List view
    document.addEventListener('DOMContentLoaded', function () {
        const gridViewBtn = document.getElementById('gridView');
        const listViewBtn = document.getElementById('listView');
        const coursesContainer = document.getElementById('coursesContainer');

        if (gridViewBtn && listViewBtn && coursesContainer) {
            gridViewBtn.addEventListener('click', function () {
                coursesContainer.classList.remove('list-view');
                gridViewBtn.classList.add('active');
                listViewBtn.classList.remove('active');
            });
            listViewBtn.addEventListener('click', function () {
                coursesContainer.classList.add('list-view');
                listViewBtn.classList.add('active');
                gridViewBtn.classList.remove('active');
            });
        }
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const gridViewBtn = document.getElementById('gridView');
        const listViewBtn = document.getElementById('listView');
        const grid = document.getElementById('coursesContainer'); // GRID container
        const list = document.getElementById('coursesList');      // LIST container

        function showGrid() {
            grid.classList.remove('d-none');
            list.classList.add('d-none');
            gridViewBtn.classList.add('active');
            listViewBtn.classList.remove('active');
        }

        function showList() {
            grid.classList.add('d-none');
            list.classList.remove('d-none');
            listViewBtn.classList.add('active');
            gridViewBtn.classList.remove('active');
        }

        gridViewBtn.addEventListener('click', showGrid);
        listViewBtn.addEventListener('click', showList);

        // Khởi tạo: mặc định Grid
        showGrid();
    });
</script>
{{/section}}
{{!-- ========================= CSS ========================= --}}
{{#section "css"}}
<style>
    /* Hero */
    .courses-hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        position: relative;
        overflow: hidden;
        color: #fff;
    }

    .courses-hero-section::before {
        content: '';
        position: absolute;
        inset: 0;
        opacity: .1;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    }

    .hero-content,
    .hero-stats {
        position: relative;
        z-index: 2;
    }

    .search-box .input-group {
        max-width: 500px;
    }

    .search-box .form-control {
        border: none;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .1);
    }

    .search-box .btn {
        box-shadow: 0 4px 15px rgba(0, 0, 0, .1);
    }

    /* Sidebar filter */
    .filter-card {
        border-radius: 20px;
        overflow: hidden;
        background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
    }

    .filter-group {
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .filter-group:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .form-select {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        transition: .3s;
    }

    .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 .2rem rgba(102, 126, 234, .25);
    }

    .form-check-input:checked {
        background-color: #667eea;
        border-color: #667eea;
    }

    /* Courses grid + cards */
    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
    }

    .course-card {
        background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
        border-radius: 20px;
        overflow: hidden;
        transition: .3s;
    }

    .course-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, .15) !important;
    }

    .course-image img {
        transition: transform .3s ease;
        height: 240px;
        object-fit: cover;
        width: 100%;
    }

    .course-card:hover .course-image img {
        transform: scale(1.05);
    }

    .course-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, .7);
        opacity: 0;
        transition: .3s;
    }

    .course-card:hover .course-overlay {
        opacity: 1;
    }

    .course-actions .btn {
        border-radius: 10px;
        font-weight: 500;
        transition: .3s;
    }

    .course-actions .btn:hover {
        transform: translateY(-2px);
    }

    /* View toggle */
    .view-options .btn-group .btn {
        border-radius: 10px;
        margin: 0 2px;
    }

    .view-options .btn.active {
        background-color: #667eea;
        border-color: #667eea;
        color: #fff;
    }

    /* List view */
    .courses-grid.list-view {
        display: block;
    }

    .courses-grid.list-view .course-card-wrapper {
        margin-bottom: 1.5rem;
    }

    .courses-grid.list-view .course-card {
        display: flex;
        flex-direction: row;
        max-height: 200px;
    }

    .courses-grid.list-view .course-image {
        width: 300px;
        flex-shrink: 0;
    }

    .courses-grid.list-view .course-image img {
        height: 200px;
    }

    .courses-grid.list-view .card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .courses-grid.list-view .course-actions {
        margin-top: auto;
    }

    /* Empty state */
    .empty-state {
        padding: 4rem 2rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .courses-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .hero-stats {
            margin-top: 2rem;
        }

        .search-box .input-group {
            flex-direction: column;
        }

        .search-box .form-control {
            border-radius: 10px !important;
            margin-bottom: 1rem;
        }

        .search-box .btn {
            border-radius: 10px !important;
        }

        .courses-grid.list-view .course-card {
            flex-direction: column;
            max-height: none;
        }

        .courses-grid.list-view .course-image {
            width: 100%;
        }

        .courses-grid.list-view .course-image img {
            height: 240px;
        }
    }
</style>
{{/section}}

