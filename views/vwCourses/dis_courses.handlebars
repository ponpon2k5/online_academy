{{#section "js"}}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    //lắng nghe tất cả sự kiện submit trên trang.
    document.addEventListener('submit', function (e) {
        const form = e.target; //form mà bạn vừa submit.
        if (form.matches('form[action^="/courses/purchase-courses-process/"]')) { //kiểm tra xem form có action bắt đầu bằng /courses/purchase-courses-process/ hay không.
            const btn = form.querySelector('button[type="submit"]'); //lấy nút “Purchase” trong form.
            if (btn) {
                btn.disabled = true; //vô hiệu hóa nút để người dùng không bấm 2 lần.
                btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang xử lý...`;//thay nội dung nút bằng spinner Bootstrap (vòng xoay nhỏ) kèm chữ “Đang xử lý...”.
            }
        }
    });

    // 2) Sau khi server redirect về: đọc query ?toast=...&msg=... để show thông báo
    const params = new URLSearchParams(location.search); //giúp bạn dễ dàng lấy giá trị của từng tham số:
    const toast = params.get('toast'); //success / error / warning / info / null
    const msg = params.get('msg');
    if (toast && msg) {
        Swal.fire({
            icon: toast,
            title: toast === 'success' ? 'Thành công!' : (toast === 'error' ? 'Lỗi!' : 'Thông báo'),
            text: msg
        });
        // Xoá query khỏi URL để refresh không hiện lại
        history.replaceState(null, '', location.pathname);
    }
</script>
{{/section}}
<div class="row">
    <!-- Cột trái: Filter -->
    <div class="col-lg-4">
        <div class="card shadow-sm mt-3">
            <div class="card-header fw-semibold">
                Bộ lọc khóa học
            </div>
            <div class="card-body">
                <form method="GET" action="/courses/view-courses" id="filterForm">
                    <!-- Danh mục -->
                    <h6 class="fw-bold">Danh mục</h6>
                    <select class="form-select mb-3" name="category">
                        <option value="">Tất cả</option>
                        <option value="Web">Lập trình Web</option>
                        <option value="Mobile">Lập trình Mobile</option>
                        <option value="AI">Trí tuệ nhân tạo</option>
                    </select>

                    <!-- Mức giá
                    <h6 class="fw-bold">Mức giá</h6>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="price" id="free" checked>
                        <label class="form-check-label" for="free">Miễn phí</label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="price" id="paid">
                        <label class="form-check-label" for="paid">Trả phí</label>
                    </div>
                    -->

                    <!-- Đánh giá
                    <h6 class="fw-bold">Đánh giá</h6>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rate5">
                        <label class="form-check-label" for="rate5">★★★★★ (5 sao)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rate4">
                        <label class="form-check-label" for="rate4">★★★★☆ trở lên</label>
                    </div>
                    -->
                    <button class="btn btn-primary w-100 mt-3">Áp dụng</button>
                </form>
            </div>

        </div>
    </div>
    <!-- Cột trái: Ds khóa học -->
    <div class="col-lg-8">
        <div class="d-flex flex-wrap gap-3">
            {{#if courses}}
            {{#each courses}}
            <div class="card" style="width: 15rem;">

                <img src="/images/{{hero_image_url}}.jpg" class="card-img-top" alt="Ảnh môn học" loading="lazy"
                    style="height: 180px;">
                <div class="card-body p-2">
                    <h6 class="card-title mb-1 text-truncate">{{title}}</h6>
                    <p class="card-text small text-muted text-truncate">
                        {{short_desc}}
                    </p>
                    <div class="d-flex gap-2">
                        <a href="/courses/course-detail/{{id}}" class="btn btn-outline-primary btn-sm flex-fill">View
                            Detail</a>
                        <a href="/courses/purchase-courses-process/{{id}}"
                            class="btn btn-primary btn-sm flex-fill">Purchase</a>
                    </div>
                </div>
            </div>
            {{/each}}
            {{else}}
            {{#each list}}
            <div class="card" style="width: 15rem;">

                <img src="/images/{{hero_image_url}}.jpg" class="card-img-top" alt="Ảnh môn học" loading="lazy"
                    style="height: 180px;">
                <div class="card-body p-2">
                    <h6 class="card-title mb-1 text-truncate">{{title}}</h6>
                    <p class="card-text small text-muted text-truncate">
                        {{short_desc}}
                    </p>
                    <div class="d-flex gap-2">
                        <a href="/courses/course-detail/{{id}}" class="btn btn-outline-primary btn-sm flex-fill">View
                            Detail</a>
                        <form action="/courses/purchase-courses-process/{{id}}" method="POST">
                            <button type="submit" class="btn btn-success">Purchase</button>
                        </form>
                    </div>
                </div>
            </div>
            {{/each}}
            {{/if}}
        </div>
    </div>
</div>