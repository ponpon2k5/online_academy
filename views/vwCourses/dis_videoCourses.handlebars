<main class="container py-4">
    <div class="row g-4">
        <!-- Trái: video + điều hướng -->
        <div class="col-lg-8">
            <h1 class="h5 mb-1">{{courseTitle}}</h1>
            <div class="text-muted small mb-2">Khoá: {{current_lesson.lesson}}</div>

            <!-- Player: YouTube hoặc Local Video -->
            <div class="card">
                <div class="card-body p-2">
                    <div class="ratio ratio-16x9">
                        {{#if isYouTube}}
                        <!-- YouTube Player -->
                        <iframe id="yt-player" src="https://www.youtube.com/embed/{{embed_id}}?enablejsapi=1&rel=0&modestbranding=1&playsinline=1"
                            allowfullscreen
                            loading="lazy">
                        </iframe>
                        {{else}}
                        <!-- Local Video Player -->
                        <video id="local-video-player" 
                               controls 
                               preload="metadata"
                               style="width: 100%; height: 100%;">
                            <source src="{{localVideoUrl}}" type="video/mp4">
                            <source src="{{localVideoUrl}}" type="video/webm">
                            <source src="{{localVideoUrl}}" type="video/ogg">
                            Trình duyệt của bạn không hỗ trợ phát video.
                        </video>
                        {{/if}}
                    </div>
                </div>
            </div>

            <!-- Điều hướng -->
            <div class="d-flex align-items-center gap-2 mt-3">
                {{#if prev_lesson_id}}
                <a class="btn btn-outline-secondary btn-sm"
                    href="/courses/preview-lessons/{{courseId}}?lesson={{prev_lesson_id}}">Bài trước</a>
                {{/if}}

                {{#if next_lesson_id}}
                <a class="btn btn-primary btn-sm"
                    href="/courses/preview-lessons/{{courseId}}?lesson={{next_lesson_id}}">Bài tiếp</a>
                {{/if}}

                <form method="post" action="/courses/lesson-complete/{{current_lesson.id}}" class="ms-auto">
                    <button class="btn btn-success btn-sm" type="submit">Hoàn thành</button>
                </form>
            </div>

            {{#if des_current_lesson}}
            <div class="card mt-3">
                <div class="card-header fw-semibold">Mô tả bài học</div>
                <div class="card-body">
                    <p class="mb-0 small">{{des_current_lesson}}</p>
                </div>
            </div>
            {{/if}}
        </div>

        <!-- Phải: danh sách bài học -->
        <div class="col-lg-4">
            <aside class="sticky-top" style="top: 80px;">
                <div class="card">
                    <div class="card-header">Danh sách bài học</div>
                    <div class="list-group list-group-flush">
                        {{#each lessons}}
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{#if this.is_current}}active{{/if}}"
                            href="/courses/preview-lessons/{{course_id}}?lesson={{id}}">
                            <span>{{lesson}}</span>
                            <small class="text-muted">{{duration_seconds}}s</small>
                        </a>
                        {{/each}}
                    </div>
                </div>
            </aside>
        </div>
    </div>
</main>
{{#if isYouTube}}
<script src="https://www.youtube.com/iframe_api"></script>
{{/if}}
<script>
    const LESSON_ID = "{{current_lesson.id}}";
    const RESUME = Number("{{resume_seconds}}") || 0;
    const IS_YOUTUBE = {{#if isYouTube}}true{{else}}false{{/if}};

    let player, tick;

    {{#if isYouTube}}
    // YouTube Player
    function onYouTubeIframeAPIReady() {
        player = new YT.Player('yt-player', {
            events: {
                onReady: () => {
                    if (RESUME > 0) player.seekTo(Math.max(RESUME - 2, 0), true);
                    tick = setInterval(saveTick, 5000);
                },
                onStateChange: (e) => {
                    const END = 0, PAUSED = 2;
                    if (e.data === END) saveNow(true);
                    if (e.data === PAUSED) saveNow(false);
                }
            }
        });
    }

    function getCurrentTime() {
        return Math.floor(player?.getCurrentTime?.() || 0);
    }
    {{else}}
    // Local Video Player
    const videoElement = document.getElementById('local-video-player');
    if (videoElement) {
        player = videoElement;
        
        // Resume từ vị trí đã xem
        player.addEventListener('loadedmetadata', () => {
            if (RESUME > 0) {
                player.currentTime = Math.max(RESUME - 2, 0);
            }
            tick = setInterval(saveTick, 5000);
        });

        // Lưu tiến độ khi video kết thúc hoặc tạm dừng
        player.addEventListener('ended', () => {
            saveNow(true);
        });

        player.addEventListener('pause', () => {
            saveNow(false);
        });
    }

    function getCurrentTime() {
        return Math.floor(player?.currentTime || 0);
    }
    {{/if}}

    function saveTick() { 
        saveNow(false); 
    }

    function saveNow(done) {
        const t = getCurrentTime();
        fetch('/courses/save-progress', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lesson_id: LESSON_ID, seconds: t, completed: !!done })
        }).catch(() => {});
    }

    // Lưu khi rời trang (ít bị rớt)
    window.addEventListener('pagehide', () => {
        try {
            const t = getCurrentTime();
            navigator.sendBeacon('/courses/save-progress', new Blob(
                [JSON.stringify({ lesson_id: LESSON_ID, seconds: t })],
                { type: 'application/json' }
            ));
        } catch { }
        if (tick) clearInterval(tick);
    });
</script>