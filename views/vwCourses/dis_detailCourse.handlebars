{{#section 'js'}}
<script>
    document.querySelectorAll(".description").forEach(el => {
        el.innerHTML = el.dataset.html;
    });

    // --- Xử lý thêm vào giỏ hàng bằng AJAX + SweetAlert ---
    const btnAdd = document.getElementById('btnAddToCart');
    if (btnAdd) {
        btnAdd.addEventListener('click', async (e) => {
            e.preventDefault();
            const courseId = btnAdd.dataset.courseId;

            try {
                const res = await fetch('/courses/add-to-cart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ course_id: courseId })
                });

                if (!res.ok) {
                    throw new Error('Lỗi kết nối máy chủ');
                }

                const text = await res.text(); // server hiện đang redirect, nên ta chỉ nhận text
                if (res.redirected) {
                    // Nếu server redirect về /account/signin -> user chưa đăng nhập
                    if (res.url.includes('/account/signin')) {
                        Swal.fire({
                            title: 'Cần đăng nhập!',
                            text: 'Vui lòng đăng nhập để thêm khóa học vào giỏ hàng.',
                            icon: 'warning',
                            confirmButtonText: 'Đăng nhập ngay'
                        }).then(() => window.location.href = '/account/signin');
                        return;
                    }
                }

                // Nếu không redirect, hiện thông báo thành công
                Swal.fire({
                    title: 'Thành công!',
                    text: 'Khóa học đã được thêm vào giỏ hàng của bạn.',
                    icon: 'success',
                    confirmButtonText: 'OK'
                });

            } catch (err) {
                console.error('Lỗi khi thêm vào giỏ hàng:', err);
                Swal.fire({
                    title: 'Lỗi!',
                    text: 'Đã xảy ra lỗi khi thêm vào giỏ hàng. Vui lòng thử lại.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            }
        });
    }
</script>
{{/section}}
<main class="container py-3">
    <!-- Card header: thumbnail + core info -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="row g-0 align-items-stretch">
            <!-- Image (responsive: full width on mobile, left column on md+) -->
            <div class="col-12 col-md-5">
                <div class="ratio ratio-16x9 h-100">
                    <img src="{{getImageUrl course.hero_image_url}}" alt="Ảnh khoá học {{course.title}}"
                        class="img-fluid rounded-start rounded-top-md-0" style="object-fit: cover;" loading="lazy" />
                </div>
            </div>

            <!-- Details -->
            <div class="col-12 col-md-7">
                <div class="card-body h-100 d-flex flex-column">
                    <h1 class="h5 mb-1">{{course.title}}</h1>

                    <!-- Rating + count (nếu có) -->
                    <div class="d-flex align-items-center mb-2">
                        {{#if course.rating_avg}}
                        <span class="me-2 fw-semibold text-warning">{{course.rating_avg}}</span>
                        <span class="me-2" aria-label="{{course.rating_avg}} stars">
                            {{!-- Fallback sao bằng ký tự, không cần icon library --}}
                            {{#each course.stars_filled}}★{{/each}}{{#each course.stars_empty}}☆{{/each}}
                        </span>
                        <small class="text-muted">({{course.review_count}}★ đánh giá) - {{course.rating_count}} lượt
                            đánh giá</small>
                        {{/if}}
                    </div>
                    <!-- Giảng viên -->
                    <p class="mb-1"><i class="bi bi-person-fill me-1"></i> Giảng viên: <span
                            class="fw-semibold">{{course.instructor_name}}</span></p>

                    <!--Số lượng học viên-->
                    <p class="mb-1"><i class="bi bi-person-fill me-1"></i> Số lượng học viên: <span
                            class="fw-semibold">{{course.students_count}}</span></p>

                    <!-- Cập nhật -->
                    {{#if course.updated_at}}
                    <div class="small text-muted mb-3">
                        Cập nhật: {{formatDate course.updated_at}}
                    </div>
                    {{/if}}
                    <!-- Mô tả dài (HTML) -->
                    <!-- Mô tả ngắn -->
                    <div class="card-text text-secondary small fst-italic mb-2">
                        <i class="bi bi-info-circle me-1 text-primary"></i>
                        {{{course.short_desc}}}
                    </div>

                    <!-- Mô tả dài -->
                    <div class="card-text text-dark small lh-sm mb-3">
                        <i class="bi bi-align-left me-1 text-success"></i>
                        {{{course.long_desc}}}
                    </div>


                    <!-- Giá -->
                    <div class="mb-3">
                        {{#if course.promo_price}}
                        <span class="fs-5 fw-bold text-primary me-2">{{formatCurrency course.promo_price}}</span>
                        <span class="text-muted text-decoration-line-through">{{formatCurrency course.price}}</span>
                        {{else}}
                        <span class="fs-5 fw-bold text-primary">{{formatCurrency course.price}}</span>
                        {{/if}}
                    </div>
                    <!-- Action buttons -->
                    <div class="mt-auto d-flex flex-wrap gap-2">
                        {{#if course.user_enrolled}}
                        <a href="/learn/{{course.id}}" class="btn btn-primary">Tiếp tục học</a>
                        <a href="/reviews/{{course.id}}" class="btn btn-outline-secondary">Đánh giá khóa học</a>
                        {{else}}

                        <form action="/courses/purchase-courses-process/{{course.id}}" method="POST">
                            <button type="submit" class="btn btn-success">Ghi danh ngay</button>
                        </form>
                        <form action="/student/add-favor-courses/{{course.id}}" method="post" class="d-inline">
                            <button class="btn btn-outline-secondary" type="submit">Thêm vào Watchlist</button>
                        </form>

                        <button id="btnAddToCart" data-course-id="{{course.id}}"
                            class="btn btn-outline-primary rounded-pill px-3">
                            <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ hàng
                        </button>
                        <form action="/courses/buy-now" method="POST" class="d-inline">
                            <input type="hidden" name="course_id" value="{{course.id}}">
                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold">
                                <i class="bi bi-wallet2 me-1"></i>Mua ngay
                            </button>
                        </form>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick stats (tuỳ chọn) -->
    {{#each lessons}}
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted mb-1">Bài học</div>
                    <div class="h5 mb-0">{{lesson}}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted mb-1">Tổng thời lượng</div>
                    <div class="h5 mb-0">{{duration_seconds}}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted mb-1">Giảng viên</div>
                    <div class="h6 mb-0">{{course.instructor_name}}</div>
                </div>
            </div>
        </div>
    </div>
    {{/each}}
    {{#if existed}}
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">Viết phản hồi của bạn</h5>
                <a class="small" data-bs-toggle="collapse" href="#composeBox" role="button" aria-expanded="true"
                    aria-controls="composeBox">
                    Thu gọn/Mở rộng
                </a>
            </div>
            <div class="collapse show" id="composeBox">
                <form action="/courses/course-detail/{{course.id}}" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nội dung phản hồi</label>
                        <textarea name="comment" class="form-control" rows="3"
                            placeholder="Chia sẻ trải nghiệm học của bạn…" required></textarea>
                        <div class="invalid-feedback">Không được để trống.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" type="submit">Gửi phản hồi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {{else}}
    <h5 class="card-title mb-0">Hãy mua khóa học trước khi viết phản hồi của bạn</h5>
    {{/if}}


    <!-- Feedback list -->
    {{#if feedbacks}}
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body">
            <h5 class="card-title mb-4">
                <i class="bi bi-chat-dots-fill text-primary me-2"></i>
                Phản hồi từ học viên
            </h5>

            {{#each feedbacks}}
            <div class="border-bottom pb-3 mb-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <strong class="text-dark">{{name}} - {{role}}</strong>
                    </div>
                    {{#if this.rating}}
                    <div class="text-warning small">
                        {{#times this.rating}}★{{/times}}{{#times (subtract 5 this.rating)}}☆{{/times}}
                    </div>
                    {{/if}}
                </div>
                <p class="mb-0 mt-2">{{des}}</p>
            </div>
            {{/each}}
        </div>
    </div>
    {{else}}
    <div class="text-center py-4 text-muted mb-5">
        <i class="bi bi-emoji-smile display-6 d-block mb-2"></i>
        Chưa có phản hồi nào cho khóa học này.
    </div>
    {{/if}}
    {{#if relatedCourses.length}}
    <section class="related-courses-section py-5 bg-white">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h3 class="fw-bold mb-0">Khoá học cùng lĩnh vực</h3>
                <small class="text-muted">Top 5 được mua nhiều</small>
            </div>

            <div class="row g-4">
                {{#each relatedCourses}}
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm position-relative">
                        <a href="/courses/course-detail/{{this.id}}">
                            <img src="{{getImageUrl this.hero_image_url}}" class="card-img-top" alt="{{this.title}}"
                                style="height:180px;object-fit:cover;">
                        </a>

                        {{!-- Badge đồng bộ: Nổi bật / Mới / Giảm giá --}}
                        <div class="position-absolute top-0 end-0 m-2">
                            {{#if this.isFeatured}}
                            <span class="badge bg-warning text-dark rounded-pill px-2 py-1 small me-1 mb-1">
                                <i class="bi bi-star-fill"></i>Nổi bật
                            </span>
                            {{/if}}
                            {{#if this.isNew}}
                            <span class="badge bg-info rounded-pill px-2 py-1 small me-1 mb-1">
                                <i class="bi bi-clock"></i>Mới
                            </span>
                            {{/if}}
                            {{#if this.isOnSale}}
                            <span class="badge bg-danger rounded-pill px-2 py-1 small me-1 mb-1">
                                <i class="bi bi-tag"></i>Giảm giá
                            </span>
                            {{/if}}
                        </div>

                        <div class="card-body">
                            <h6 class="card-title mb-2">
                                <a href="/courses/course-detail/{{this.id}}" class="text-decoration-none text-dark">
                                    {{this.title}}
                                </a>
                            </h6>

                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="small text-muted">
                                    <i class="bi bi-people me-1"></i>{{this.students_count}}
                                </span>
                                <span class="small text-muted">
                                    <i class="bi bi-star-fill me-1"></i>{{this.rating_avg}} ({{this.rating_count}})
                                </span>
                            </div>

                            <!-- Giá -->
                            {{#if this.promo_price}}
                            <div>
                                <span class="text-muted text-decoration-line-through me-2">{{formatCurrency
                                    this.price}}</span>
                                <span class="fw-bold text-danger">{{formatCurrency this.promo_price}}</span>
                            </div>
                            {{else}}
                            <div>
                                <span class="fw-bold text-primary">{{formatCurrency this.price}}</span>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </section>
    {{/if}}
    <h3 class="fw-bold mb-0">Thông Tin Về Giảng Viên</h3>

    <div class="card mb-3" style="max-width: 540px;">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="/images/instructor/{{instructor_id}}.jpg" class="img-fluid rounded-start" alt="...">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h4 class="fw-bold mb-1">{{instructor.name}}</h4>
                    <p class="text-primary small mb-2">{{instructor.specialization}}</p>
                    <p class="text-muted small mb-3">Kinh nghiệm: {{instructor.experience_years}} năm</p>
                    <p class="text-muted small mb-0">{{{instructor.bio}}}</p>
                </div>
            </div>
        </div>
    </div>
</main>