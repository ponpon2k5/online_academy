        <div class="stat-card text-center p-4 rounded-4 border-0 shadow-sm h-100">
          <div class="stat-icon mb-3">
            <div
              class="icon-wrapper bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center"
