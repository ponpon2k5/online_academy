<div class="p-4 bg-white rounded shadow-sm">
  <h2 class="mb-3">Trang chủ</h2>
  <p>Chào mừng đến Online Academy.</p>
  <div class="mb-4">
    <h5 class="mb-2">Đăng nhập nhanh (mock)</h5>
    <div class="d-flex flex-wrap gap-2">
      <button class="btn btn-outline-dark" onclick="location.href='/debug/login/student'">Login Student</button>
      <button class="btn btn-outline-primary" onclick="location.href='/debug/login/instructor'">Login Instructor</button>
      <button class="btn btn-outline-danger" onclick="location.href='/debug/login/admin'">Login Admin</button>
      <button class="btn btn-outline-secondary" onclick="location.href='/debug/me'">Xem session hiện tại</button>
    </div>
  </div>

  <div class="mb-4">
    <h5 class="mb-2">Giảng viên - thao tác nhanh</h5>
    <div class="d-flex flex-wrap gap-2">
      <button class="btn btn-primary" onclick="location.href='/instructor/courses'">Danh sách khoá học</button>
      <button class="btn btn-success" onclick="location.href='/instructor/courses/new'">Tạo khoá học mới</button>
    </div>
  </div>

  <div class="mb-2">
    <h5 class="mb-2">Admin - thao tác nhanh</h5>
    <div class="d-flex flex-wrap gap-2">
      <button class="btn btn-dark" onclick="location.href='/admin/dashboard'">Dashboard</button>
      <button class="btn btn-secondary" onclick="location.href='/admin/categories'">Quản lý danh mục</button>
      <button class="btn btn-secondary" onclick="location.href='/admin/users'">Quản lý người dùng</button>
      <button class="btn btn-secondary" onclick="location.href='/admin/courses'">Quản lý khoá học</button>
    </div>
  </div>
</div>

