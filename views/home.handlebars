<!-- CTA Section -->
<section class="cta-section py-5 bg-primary text-white position-relative overflow-hidden">
  <div class="container text-center position-relative">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <h2 class="display-4 fw-bold mb-4">Sẵn sàng bắt đầu hành trình học tập?</h2>
        <p class="lead mb-5 opacity-90">
          Tham gia cùng hàng nghìn học viên khác và khám phá tiềm năng vô hạn của bạn
        </p>
        <div class="cta-actions d-flex gap-3 justify-content-center flex-wrap">
          {{#if isAuthenticated}}
          <a href="/courses/view-courses" class="btn btn-warning btn-lg px-5 py-3 rounded-pill shadow">
            <i class="bi bi-play-circle me-2"></i>Khám phá khóa học
          </a>
          {{else}}
          <a href="/account/signup" class="btn btn-warning btn-lg px-5 py-3 rounded-pill shadow">
            <i class="bi bi-person-plus me-2"></i>Đăng ký miễn phí
          </a>
          <a href="/account/signin" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill">
            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
          </a>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Custom Styles -->
<style>
  /* Hero Section */
  .hero-section {
    min-height: 80vh;
    overflow: hidden;
  }

  .hero-bg {
    min-height: 80vh;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    position: relative;
  }

  .min-vh-75 {
    min-height: 75vh;
  }

  .hero-content {
    z-index: 2;
    position: relative;
  }

  .hero-image {
    max-height: 400px;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .hero-image-wrapper {
    position: relative;
    z-index: 2;
  }

  .hero-badge {
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-content h1 {
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }

  .hero-content p {
    animation: fadeInUp 0.8s ease-out 0.4s both;
