<!-- Featured Courses Section -->
<section id="featured-courses" class="featured-courses-section py-5 bg-white">
  <div class="container">
    <div class="section-header text-center mb-5">
      <h2 class="display-4 fw-bold mb-3">Khóa học nổi bật nhất trong tuần</h2>
      <p class="lead text-muted">Những khóa học được đánh giá cao và lượt mua nhiều nhất</p>
    </div>

    {{#if featuredCourses}}
    <div class="row g-4">
      {{#each featuredCourses}}
      <div class="col-lg-4 col-md-6">
        <div class="course-card card h-100 border-0 shadow-sm overflow-hidden">
          <div class="course-image position-relative">
            <a href="/courses/course-detail/{{this.id}}">
              <img src="/images/{{this.hero_image_url}}" class="card-img-top" alt="{{this.title}}"
                style="height: 240px; object-fit: cover;">
            </a>
            <div class="course-badge position-absolute top-0 end-0 m-3">
              <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                <i class="bi bi-star-fill me-1"></i>{{this.rating_avg}}
              </span>
            </div>
            <div
              class="course-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
              <a href="/courses/course-detail/{{this.id}}" class="btn btn-warning rounded-circle play-btn">
                <i class="bi bi-play-fill fs-4"></i>
              </a>
            </div>
          </div>
          <div class="card-body p-4">
            <h5 class="card-title fw-bold mb-3">
              <a href="/courses/course-detail/{{this.id}}" class="text-decoration-none text-dark">
                {{this.title}}
              </a>
            </h5>
            <p class="card-text text-muted mb-3">{{this.short_desc}}</p>
            <div class="course-meta d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center text-muted">
                <i class="bi bi-people me-1"></i>
                <span class="small">{{this.students_count}} học viên</span>
              </div>
              <div class="course-price">
                <span class="fw-bold text-primary fs-5">{{formatCurrency this.price}}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="text-center py-5">
      <div class="empty-state">
        <i class="bi bi-book display-1 text-muted mb-4"></i>
        <h4 class="text-muted mb-3">Chưa có khóa học nổi bật</h4>
        <p class="text-muted">Hãy quay lại sau để xem các khóa học mới nhất!</p>
      </div>
    </div>
    {{/if}}
  </div>
</section>

