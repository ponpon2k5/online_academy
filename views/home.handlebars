<!-- Hero Section with Modern Slideshow -->
<section class="hero-section position-relative">
  <div id="homeCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
    <div class="carousel-inner">
      {{#each featuredCourses}}
      <div class="carousel-item {{#if @first}}active{{/if}}">
        <div class="hero-slide">
          <div class="hero-bg"
            style="background-image: linear-gradient(135deg, rgba(102, 126, 234, 0.85), rgba(118, 75, 162, 0.85)), url('/images/{{this.hero_image_url}}');">
            <div class="container">
              <div class="row align-items-center min-vh-75">
                <div class="col-lg-6">
                  <div class="hero-content text-white">
                    <div class="hero-badge mb-3">
                      <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                        <i class="bi bi-star-fill me-2"></i>Khóa học nổi bật
                      </span>
                    </div>
                    <h1 class="display-4 fw-bold mb-3 lh-1">
                      {{this.title}}
                    </h1>
                    <p class="lead mb-4 opacity-90">
                      {{this.short_desc}}
                    </p>
                    <div class="hero-stats d-flex gap-4 mb-4">
                      <div class="stat-item">
                        <div class="stat-number h5 mb-0">{{this.rating_avg}}</div>
                        <div class="stat-label small opacity-75">Đánh giá</div>
                      </div>
                      <div class="stat-item">
                        <div class="stat-number h5 mb-0">{{this.students_count}}</div>
                        <div class="stat-label small opacity-75">Học viên</div>
                      </div>
                    </div>
                    <div class="hero-actions d-flex gap-3 flex-wrap">
                      <a href="/courses/course-detail/{{this.id}}"
                        class="btn btn-warning btn-lg px-4 py-2 rounded-pill shadow">
                        <i class="bi bi-play-circle me-2"></i>Bắt đầu học
                      </a>
                      <a href="#featured-courses" class="btn btn-outline-light btn-lg px-4 py-2 rounded-pill">
                        <i class="bi bi-arrow-down me-2"></i>Khám phá thêm
                      </a>
                    </div>
                  </div>
                </div>
                <div class="col-lg-6 text-center">
                  <div class="hero-image-wrapper">
                    <img src="/images/{{this.hero_image_url}}" alt="{{this.title}}"
                      class="hero-image img-fluid rounded-4 shadow-lg">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>

    <!-- Custom Carousel Controls -->
    <button class="carousel-control-prev custom-nav-btn" type="button" data-bs-target="#homeCarousel"
      data-bs-slide="prev">
      <i class="bi bi-chevron-left"></i>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next custom-nav-btn" type="button" data-bs-target="#homeCarousel"
      data-bs-slide="next">
      <i class="bi bi-chevron-right"></i>
      <span class="visually-hidden">Next</span>
    </button>

    <!-- Custom Indicators -->
    <div class="carousel-indicators d-flex justify-content-center gap-2 mt-3">
      {{#each featuredCourses}}
      <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="{{@index}}"
        class="indicator-dot btn btn-light rounded-circle shadow-sm border-0 opacity-50 {{#if @first}}active opacity-100{{/if}}"
        aria-current="{{#if @first}}true{{/if}}" aria-label="Slide {{add @index 1}}"></button>
      {{/each}}
    </div>
  </div>
</section>

<!-- Stats Section -->
<section class="stats-section py-5 bg-white">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-3 col-md-6">
        <div class="stat-card text-center p-4 rounded-4 border-0 shadow-sm h-100">
