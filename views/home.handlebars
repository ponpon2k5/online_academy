            <div
              class="icon-wrapper bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center"
              style="width: 80px; height: 80px;">
              <i class="bi bi-mortarboard-fill display-4 text-warning"></i>
            </div>
