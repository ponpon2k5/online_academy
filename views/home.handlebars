<div class="py-5 text-center">
  <h1 class="display-4 fw-bold mb-3">Welcome to Online Academy</h1>
  <p class="lead mb-4">
    Discover thousands of courses from top instructors. Learn new skills, advance your career, or explore a new hobby—all in one place.
  </p>
  <a href="/courses/view-courses" class="btn btn-primary btn-lg px-4">Browse Courses</a>
  
  <h3>🔥 Featured Courses</h3>
<div class="row mt-3">
  {{#each featuredCourses}}
  <div class="col-md-4">
    <div class="card shadow-sm">
      <img src="{{this.image}}" class="card-img-top" alt="{{this.title}}">
      <div class="card-body">
        <h5 class="card-title">{{this.title}}</h5>
        <p class="card-text">{{this.description}}</p>
        <a href="/course/{{this.id}}" class="btn btn-primary">View Details</a>
      </div>
    </div>
  </div>
  {{/each}}
</div>
<h3 class="mt-5">🔥 Most Viewed Courses</h3>
<div class="row mt-3">
  {{#each mostViewedCourses}}
  <div class="col-md-3">
    <div class="card">
      <img src="{{this.image}}" class="card-img-top">
      <div class="card-body">
        <h5>{{this.title}}</h5>
      </div>
    </div>
  </div>
  {{/each}}
</div>

<h3 class="mt-5">🆕 Newest Courses</h3>
<div class="row mt-3">
  {{#each newestCourses}}
  <div class="col-md-3">
    <div class="card">
      <img src="{{this.image}}" class="card-img-top">
      <div class="card-body">
        <h5>{{this.title}}</h5>
      </div>
    </div>
  </div>
  {{/each}}
</div>
