{{#> std_profile}}
<div class="card shadow-sm">
    <div class="card-header fw-semibold">Khóa học của bạn</div>
    <div class="card-body">

        {{#if empty}}
        <div class="text-muted">Chưa có tiến độ nào cho tài khoản này.</div>
        {{else}}
        <div class="d-flex flex-wrap gap-3">
            {{#each progress}}
            <div class="card mb-3" style="width: 16rem;">
                <img src="/images/{{course_img}}.jpg" class="card-img-top" alt="{{course_title}}">
                <div class="card-body">
                    <h6 class="card-title">{{course_title}}</h6>
                    <div class="small text-muted mb-1">{{lesson_title}}</div>
                    <div class="small">Tiến độ: {{last_second}}s — {{finish_text}}</div>
                </div>
            </div>
            {{/each}}
        </div>

        {{#if pagination}}
        <nav aria-label="Pagination">
            <ul class="pagination justify-content-center">
                {{#if pagination.hasPrev}}
                <li class="page-item">
                    <a class="page-link" href="?page={{pagination.prevPage}}">&laquo;</a>
                </li>
                {{/if}}
                {{#each pagination.pages}}
                <li class="page-item {{#if active}}active{{/if}}">
                    <a class="page-link" href="?page={{number}}">{{number}}</a>
                </li>
                {{/each}}
                {{#if pagination.hasNext}}
                <li class="page-item">
                    <a class="page-link" href="?page={{pagination.nextPage}}">&raquo;</a>
                </li>
                {{/if}}
            </ul>
        </nav>
        {{/if}}
        {{/if}}

    </div>
</div>
{{/std_profile}}