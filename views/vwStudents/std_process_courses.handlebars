{{#> std_profile}}

<style>
    .process-courses-header {
        background: linear-gradient(135deg, #0d6efd 0%, #0056b3 100%);
        color: white;
        border: none;
        padding: 1.5rem;
    }
    
    .process-courses-header i {
        font-size: 1.3rem;
    }
    
    .course-card-wrapper-process {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
    }
    
    .course-card-wrapper-process:hover {
        transform: translateY(-8px);
    }
    
    .course-card-process {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        background: white;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    
    .course-card-process:hover {
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
    }
    
    .course-image-wrapper-process {
        position: relative;
        overflow: hidden;
    }
    
    .course-image-wrapper-process::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.1) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .course-card-wrapper-process:hover .course-image-wrapper-process::after {
        opacity: 1;
    }
    
    .course-image-wrapper-process img {
        transition: transform 0.5s ease;
    }
    
    .course-card-wrapper-process:hover .course-image-wrapper-process img {
        transform: scale(1.1);
    }
    
    .progress-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 10;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }
    
    .progress-badge.completed {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
    }
    
    .progress-badge.in-progress {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
    }
    
    .progress-badge i {
        font-size: 0.875rem;
    }
    
    .course-card-body-process {
        padding: 1rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }
    
    .course-title-process {
        font-size: 0.95rem;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.75rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.8rem;
    }
    
    .lesson-info {
        color: #6b7280;
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .progress-info {
        color: #6b7280;
        font-size: 0.85rem;
        margin-bottom: 0.75rem;
    }
    
    .progress-status {
        font-size: 0.875rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.375rem;
        margin-top: auto;
    }
    
    .progress-status.completed {
        color: #10b981;
    }
    
    .progress-status.in-progress {
        color: #f59e0b;
    }
    
    .course-action-btn-process {
        background: linear-gradient(135deg, #0d6efd 0%, #0056b3 100%);
        border: none;
        color: white;
        padding: 0.6rem;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
        display: block;
        margin-top: 0.75rem;
    }
    
    .course-action-btn-process:hover {
        background: linear-gradient(135deg, #0056b3 0%, #0d6efd 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);
    }
    
    .empty-state-process {
        padding: 4rem 2rem;
        text-align: center;
    }
    
    .empty-state-icon-process {
        font-size: 5rem;
        color: #cbd5e0;
        margin-bottom: 1.5rem;
        display: block;
    }
    
    .empty-state-title-process {
        font-size: 1.5rem;
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 0.5rem;
    }
    
    .empty-state-text-process {
        color: #718096;
        font-size: 1rem;
    }
    
    .courses-count-badge-process {
        background: rgba(255, 255, 255, 0.25);
        color: white;
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-weight: 500;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
    }
</style>

<div class="card shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">
    <div class="card-header fw-semibold d-flex align-items-center justify-content-between process-courses-header">
        <span><i class="bi bi-gear-wide-connected me-2"></i> Tiến độ học tập</span>
        {{#if total}}
        <span class="courses-count-badge-process">{{total}} khóa học</span>
        {{/if}}
    </div>

    <div class="card-body p-4">
        {{#if empty}}
        <!-- Trạng thái rỗng -->
        <div class="empty-state-process">
            <i class="bi bi-clock-history empty-state-icon-process"></i>
            <h4 class="empty-state-title-process">Chưa có tiến độ học tập</h4>
            <p class="empty-state-text-process">Bạn chưa bắt đầu học khóa học nào. Hãy đăng ký và bắt đầu học ngay nhé!</p>
        </div>
        {{else}}
        <!-- Grid responsive - 2 cột (2 trên 2 dưới) -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-2 g-4">
            {{#each progress}}
            <div class="col d-flex course-card-wrapper-process">
                <div class="card h-100 w-100 course-card-process">

                    <!-- Badge trạng thái -->
                    <span class="progress-badge {{#if (eq finish_text 'Hoàn thành khóa học')}}completed{{else}}in-progress{{/if}}">
                        {{#if (eq finish_text 'Hoàn thành khóa học')}}
                        <i class="bi bi-check-circle"></i>Hoàn thành
                        {{else}}
                        <i class="bi bi-hourglass-split"></i>Đang học
                        {{/if}}
                    </span>

                    <!-- Ảnh khóa học -->
                    <div class="course-image-wrapper-process">
                        <a href="/courses/course-detail/{{course_id}}" class="ratio ratio-16x9 d-block text-decoration-none">
                            <img src="{{getImageUrl course_img}}" class="w-100 h-100 object-fit-cover"
                                alt="{{course_title}}" loading="lazy">
                        </a>
                    </div>

                    <!-- Thông tin -->
                    <div class="course-card-body-process">
                        <h6 class="course-title-process" title="{{course_title}}">{{course_title}}</h6>

                        <div class="lesson-info" title="{{lesson_title}}">
                            <i class="bi bi-play-circle me-1"></i>{{lesson_title}}
                        </div>

                        <div class="progress-info">
                            <i class="bi bi-clock me-1"></i>Tiến độ: {{last_second}}s
                        </div>

                        <div class="progress-status {{#if (eq finish_text 'Hoàn thành khóa học')}}completed{{else}}in-progress{{/if}}">
                            {{#if (eq finish_text 'Hoàn thành khóa học')}}
                            <i class="bi bi-check-circle-fill"></i>
                            {{else}}
                            <i class="bi bi-hourglass-split"></i>
                            {{/if}}
                            {{finish_text}}
                        </div>

                        <a href="/learn/{{course_id}}" class="course-action-btn-process">
                            <i class="bi bi-play-circle me-2"></i>Tiếp tục học
                        </a>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{/if}}
    </div>
</div>

{{/std_profile}}