{{#> std_profile}}
<div class="card shadow-sm border-0">
    <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
        <span><i class="bi bi-collection-play me-2"></i>Khóa học của bạn</span>
        {{#if courses}}
        <span class="badge bg-primary-subtle text-primary">{{courses.length}} khóa học</span>
        {{/if}}
    </div>

    <div class="card-body">
        {{#if courses}}
        <!-- Grid responsive -->
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            {{#each courses}}
            <div class="col d-flex">
                <div class="card h-100 w-100 shadow-sm border-0 position-relative">

                    <!-- Delete button (top-right) -->
                    <button type="button"
                        class="btn btn-light btn-sm rounded-circle position-absolute top-0 end-0 m-2 delete-btn"
                        data-bs-toggle="tooltip" data-bs-title="Xóa khỏi yêu thích" data-course-id="{{id}}">
                        <i class="bi bi-x-lg"></i>
                    </button>

                    <!-- Image 16:9 -->
                    <a href="/courses/course-detail/{{id}}" class="ratio ratio-16x9">
                        <img src="/images/{{hero_image_url}}.jpg" class="w-100 h-100 object-fit-cover rounded-top"
                            alt="{{title}}" loading="lazy">
                    </a>

                    <div class="card-body p-2">
                        <h6 class="card-title mb-1 text-truncate" title="{{title}}">{{title}}</h6>
                        <p class="card-text small text-muted text-truncate" title="{{long_desc}}">
                            {{long_desc}}
                        </p>
                        <div class="d-flex gap-2">
                            <a href="/courses/preview-lessons/{{id}}" class="btn btn-outline-primary btn-sm flex-fill">
                                Lesson
                            </a>
                            <a href="/courses/course-detail/{{id}}" class="btn btn-primary btn-sm flex-fill">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{else}}
        <!-- Empty state -->
        <div class="text-center text-muted py-5">
            <i class="bi bi-emoji-frown fs-1 d-block mb-2"></i>
            Chưa có khóa học nào trong danh sách của bạn.
        </div>
        {{/if}}
    </div>
</div>
{{/std_profile}}