{{#> std_profile}}

<style>
    .purchased-courses-header {
        background: linear-gradient(135deg, #0d6efd 0%, #0056b3 100%);
        color: white;
        border: none;
        padding: 1.5rem;
    }
    
    .purchased-courses-header i {
        font-size: 1.3rem;
    }
    
    .course-card-wrapper-purchased {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
    }
    
    .course-card-wrapper-purchased:hover {
        transform: translateY(-8px);
    }
    
    .course-card-purchased {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        background: white;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    
    .course-card-purchased:hover {
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
    }
    
    .course-image-wrapper-purchased {
        position: relative;
        overflow: hidden;
    }
    
    .course-image-wrapper-purchased::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.1) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .course-card-wrapper-purchased:hover .course-image-wrapper-purchased::after {
        opacity: 1;
    }
    
    .course-image-wrapper-purchased img {
        transition: transform 0.5s ease;
    }
    
    .course-card-wrapper-purchased:hover .course-image-wrapper-purchased img {
        transform: scale(1.1);
    }
    
    .course-card-body-purchased {
        padding: 1rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }
    
    .course-title-purchased {
        font-size: 0.95rem;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.75rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.8rem;
    }
    
    .course-description-purchased {
        color: #6b7280;
        font-size: 0.85rem;
        line-height: 1.5;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex-grow: 1;
    }
    
    .course-actions-purchased {
        display: flex;
        gap: 0.5rem;
        margin-top: auto;
    }
    
    .btn-lesson {
        background: white;
        border: 1.5px solid #0d6efd;
        color: #0d6efd;
        padding: 0.6rem;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        text-decoration: none;
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        white-space: nowrap;
    }
    
    .btn-lesson i {
        font-size: 0.9rem;
        flex-shrink: 0;
    }
    
    .btn-lesson:hover {
        background: #0d6efd;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
    
    .btn-detail-purchased {
        background: linear-gradient(135deg, #0d6efd 0%, #0056b3 100%);
        border: none;
        color: white;
        padding: 0.6rem;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        text-decoration: none;
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        white-space: nowrap;
    }
    
    .btn-detail-purchased i {
        font-size: 0.9rem;
        flex-shrink: 0;
    }
    
    .btn-detail-purchased:hover {
        background: linear-gradient(135deg, #0056b3 0%, #0d6efd 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);
    }
    
    .empty-state-purchased {
        padding: 4rem 2rem;
        text-align: center;
    }
    
    .empty-state-icon-purchased {
        font-size: 5rem;
        color: #cbd5e0;
        margin-bottom: 1.5rem;
        display: block;
    }
    
    .empty-state-title-purchased {
        font-size: 1.5rem;
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 0.5rem;
    }
    
    .empty-state-text-purchased {
        color: #718096;
        font-size: 1rem;
    }
    
    .courses-count-badge-purchased {
        background: rgba(255, 255, 255, 0.25);
        color: white;
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-weight: 500;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
    }
    
    .purchased-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 10;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }
    
    .purchased-badge i {
        font-size: 0.875rem;
    }
</style>

<div class="card shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">
    <div class="card-header fw-semibold d-flex align-items-center justify-content-between purchased-courses-header">
        <span><i class="bi bi-bag-check-fill me-2"></i> Khóa học đã mua</span>
        {{#if total}}
        <span class="courses-count-badge-purchased">{{total}} khóa học</span>
        {{/if}}
    </div>

    <div class="card-body p-4">
        {{#if courses}}
        <!-- Grid responsive - 2 cột (2 trên 2 dưới) -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-2 g-4">
            {{#each courses}}
            <div class="col d-flex course-card-wrapper-purchased">
                <div class="card h-100 w-100 course-card-purchased">

                    <!-- Badge đã mua -->
                    <span class="purchased-badge">
                        <i class="bi bi-check-circle me-1"></i>Đã mua
                    </span>

                    <!-- Ảnh khóa học -->
                    <div class="course-image-wrapper-purchased">
                        <a href="/courses/course-detail/{{id}}" class="ratio ratio-16x9 d-block text-decoration-none">
                            <img src="{{getImageUrl hero_image_url}}" class="w-100 h-100 object-fit-cover"
                                alt="{{title}}" loading="lazy">
                        </a>
                    </div>

                    <!-- Thông tin -->
                    <div class="course-card-body-purchased">
                        <h6 class="course-title-purchased" title="{{title}}">{{title}}</h6>

                        <p class="course-description-purchased" title="{{long_desc}}">
                            {{long_desc}}
                        </p>

                        <div class="course-actions-purchased">
                            <a href="/courses/preview-lessons/{{id}}" class="btn-lesson">
                                <i class="bi bi-play-circle me-1"></i>Lesson
                            </a>
                            <a href="/courses/course-detail/{{id}}" class="btn-detail-purchased">
                                <i class="bi bi-arrow-right-circle me-1"></i>Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{else}}
        <!-- Trạng thái rỗng -->
        <div class="empty-state-purchased">
            <i class="bi bi-bag empty-state-icon-purchased"></i>
            <h4 class="empty-state-title-purchased">Chưa có khóa học nào</h4>
            <p class="empty-state-text-purchased">Bạn chưa mua khóa học nào. Hãy khám phá và mua các khóa học phù hợp với bạn nhé!</p>
        </div>
        {{/if}}
    </div>
</div>

{{/std_profile}}