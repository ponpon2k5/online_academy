<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0"><i class="bi bi-speedometer2"></i> Bảng điều khiển giảng viên</h3>
  <div class="text-muted">
    <i class="bi bi-person-circle"></i> Xin chào, {{#if authUser}}{{authUser.full_name}}{{else}}Giảng viên{{/if}}
  </div>
</div>

<!-- Thống kê tổng quan -->
<div class="row mb-4">
  <div class="col-md-3">
    <div class="card bg-primary text-white">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h4 class="mb-0">{{totalCourses}}</h4>
            <p class="mb-0">Khóa học</p>
          </div>
          <div class="align-self-center">
            <i class="bi bi-book display-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-success text-white">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h4 class="mb-0">{{totalStudents}}</h4>
            <p class="mb-0">Học viên</p>
          </div>
          <div class="align-self-center">
            <i class="bi bi-people display-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-warning text-white">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h4 class="mb-0">{{totalLessons}}</h4>
            <p class="mb-0">Bài học</p>
          </div>
          <div class="align-self-center">
            <i class="bi bi-play-circle display-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-info text-white">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <h4 class="mb-0">{{avgRating}}</h4>
            <p class="mb-0">Đánh giá TB</p>
          </div>
          <div class="align-self-center">
            <i class="bi bi-star display-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- Khóa học gần đây -->
<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Khóa học gần đây</h5>
        <a href="/instructor/courses" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
      </div>
      <div class="card-body">
        {{#if recentCourses.length}}
        <div class="list-group list-group-flush">
          {{#each recentCourses}}
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <h6 class="mb-1">{{this.title}}</h6>
              <small class="text-muted">{{this.category_name}} • {{formatDate this.created_at}}</small>
            </div>
            <div>
              <span class="badge {{#if (eq this.status 'published')}}bg-success{{else}}bg-secondary{{/if}}">
                {{#if (eq this.status 'published')}}Đã xuất bản{{else}}Bản nháp{{/if}}
              </span>
            </div>
          </div>
          {{/each}}
        </div>
        {{else}}
        <div class="text-center py-4">
          <i class="bi bi-book display-4 text-muted"></i>
          <p class="text-muted mt-2">Chưa có khóa học nào</p>
          <a href="/instructor/courses/new" class="btn btn-primary">Tạo khóa học đầu tiên</a>
        </div>
        {{/if}}
      </div>
    </div>
  </div>
  
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-graph-up"></i> Thống kê</h5>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <div class="d-flex justify-content-between">
            <span>Khóa học đã xuất bản:</span>
            <strong>{{publishedCourses}}</strong>
          </div>
        </div>
        <div class="mb-3">
          <div class="d-flex justify-content-between">
            <span>Khóa học bản nháp:</span>
            <strong>{{draftCourses}}</strong>
          </div>
        </div>
        <div class="mb-3">
          <div class="d-flex justify-content-between">
            <span>Tổng doanh thu:</span>
            <strong>{{formatCurrency totalRevenue}}</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

