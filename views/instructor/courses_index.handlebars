<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0"><i class="bi bi-book"></i> Quản lý khóa học</h3>
  <a href="/instructor/courses/new" class="btn btn-primary">
    <i class="bi bi-plus-circle"></i> Tạo khóa học mới
  </a>
</div>

{{#if courses.length}}
<div class="row">
  {{#each courses}}
  <div class="col-md-6 col-lg-4 mb-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h5 class="card-title">{{this.title}}</h5>
          <span class="badge {{#if (eq this.status 'published')}}bg-success{{else}}bg-secondary{{/if}}">
            {{#if (eq this.status 'published')}}Đã xuất bản{{else}}Bản nháp{{/if}}
          </span>
        </div>
        
        <p class="text-muted small mb-2">
          <i class="bi bi-tag"></i> {{this.category_name}}
        </p>
        
        <div class="row text-center mb-3">
          <div class="col-4">
            <div class="fw-bold text-primary">{{this.students_count}}</div>
            <small class="text-muted">Học viên</small>
          </div>
          <div class="col-4">
            <div class="fw-bold text-warning">{{this.rating_avg}}</div>
            <small class="text-muted">Đánh giá</small>
          </div>
          <div class="col-4">
            <div class="fw-bold text-info">{{formatDate this.created_at}}</div>
            <small class="text-muted">Ngày tạo</small>
          </div>
        </div>
        
        <div class="d-grid gap-2">
          <a href="/instructor/courses/{{this.id}}/sections" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-list-ol"></i> Quản lý bài học
          </a>
          <div class="btn-group" role="group">
            <a href="/instructor/courses/{{this.id}}/edit" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-pencil"></i> Sửa
            </a>
            {{#if (eq this.status 'draft')}}
            <form method="post" action="/instructor/courses/{{this.id}}/publish" class="d-inline">
              <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Xuất bản khóa học này?')">
                <i class="bi bi-check-circle"></i> Xuất bản
              </button>
            </form>
            {{else}}
            <form method="post" action="/instructor/courses/{{this.id}}/unpublish" class="d-inline">
              <button type="submit" class="btn btn-warning btn-sm" onclick="return confirm('Gỡ xuất bản khóa học này?')">
                <i class="bi bi-eye-slash"></i> Gỡ xuất bản
              </button>
            </form>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<div class="text-center py-5">
  <i class="bi bi-book display-1 text-muted"></i>
  <h4 class="mt-3 text-muted">Chưa có khóa học nào</h4>
  <p class="text-muted">Bắt đầu tạo khóa học đầu tiên của bạn!</p>
  <a href="/instructor/courses/new" class="btn btn-primary">
    <i class="bi bi-plus-circle"></i> Tạo khóa học mới
  </a>
</div>
{{/if}}
