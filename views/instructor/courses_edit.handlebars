<h3 class="mb-3">Edit Course</h3>
<form method="post" action="/instructor/courses/{{course.id}}/edit" class="row g-3" enctype="multipart/form-data">
  <div class="col-md-6">
    <label class="form-label">Title *</label>
    <input name="title" class="form-control" required value="{{course.title}}"/>
  </div>
  <div class="col-md-6">
    <label class="form-label">Category *</label>
    <select name="category_id" class="form-select" required>
      {{#each categories}}
        <option value="{{this.id}}" {{#if (eq this.id ../course.category_id)}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
  <div class="col-md-6">
    <label class="form-label">Hình ảnh đại diện</label>
    {{#if course.hero_image_url}}
    <div class="mb-2">
      <img src="{{course.hero_image_url}}" alt="Current image" style="max-width: 200px; max-height: 150px; border-radius: 8px; border: 1px solid #ddd;">
      <div class="form-text small">Ảnh hiện tại</div>
    </div>
    {{/if}}
    <input type="file" name="hero_image" id="hero_image" class="form-control" accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"/>
    <div class="form-text">Chọn ảnh mới để thay thế (JPG, PNG, GIF, WebP - tối đa 5MB)</div>
    <div id="image_preview" class="mt-2" style="display: none;">
      <img id="preview_img" src="" alt="Preview" style="max-width: 200px; max-height: 150px; border-radius: 8px; border: 1px solid #ddd;">
      <div class="form-text small">Ảnh preview</div>
    </div>
    <input type="hidden" name="hero_image_url" value="{{course.hero_image_url}}"/>
  </div>
  <div class="col-12">
    <label class="form-label">Short Description *</label>
    <textarea name="short_desc" rows="2" class="form-control" required>{{course.short_desc}}</textarea>
  </div>
  <div class="col-12">
    <label class="form-label">Long Description *</label>
    <textarea id="long_desc" name="long_desc" class="form-control" required>{{{course.long_desc}}}</textarea>
  </div>
  <div class="col-md-4">
    <label class="form-label">Price</label>
    <input name="price" type="number" step="0.01" class="form-control" value="{{course.price}}"/>
  </div>
  <div class="col-md-4">
    <label class="form-label">Promo Price</label>
    <input name="promo_price" type="number" step="0.01" class="form-control" value="{{course.promo_price}}"/>
  </div>
  <div class="col-12 d-flex gap-2">
    <button class="btn btn-primary">Save</button>
    {{#if fromAdmin}}
      <a href="/admin/courses" class="btn btn-outline-secondary">Back</a>
    {{else}}
      <a href="/instructor/courses" class="btn btn-outline-secondary">Back</a>
    {{/if}}
  </div>
</form>

<form class="mt-3 d-flex gap-2" method="post" action="/instructor/courses/{{course.id}}/{{#if (eq course.status 'published')}}unpublish{{else}}publish{{/if}}">
  <button class="btn {{#if (eq course.status 'published')}}btn-warning{{else}}btn-success{{/if}}">
    {{#if (eq course.status 'published')}}Unpublish{{else}}Publish{{/if}}
  </button>
</form>

<script>
// Preview uploaded image
document.getElementById('hero_image').addEventListener('change', function(e) {
  const file = e.target.files[0];
  const preview = document.getElementById('image_preview');
  const img = document.getElementById('preview_img');
  
  if (file) {
    // Check file type
    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
    if (!allowedTypes.includes(file.type)) {
      alert('Định dạng file không hỗ trợ! Vui lòng chọn file JPG, PNG, GIF hoặc WebP');
      e.target.value = '';
      preview.style.display = 'none';
      return;
    }
    
    // Check file size (5MB)
    const maxSize = 5 * 1024 * 1024;
    if (file.size > maxSize) {
      alert('File quá lớn! Vui lòng chọn file nhỏ hơn 5MB');
      e.target.value = '';
      preview.style.display = 'none';
      return;
    }
    
    const reader = new FileReader();
    reader.onload = function(e) {
      img.src = e.target.result;
      preview.style.display = 'block';
    };
    reader.readAsDataURL(file);
  } else {
    preview.style.display = 'none';
  }
});
</script>
