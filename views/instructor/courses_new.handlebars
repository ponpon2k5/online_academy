<div class="card">
  <div class="card-header">
    <h3 class="mb-0"><i class="bi bi-plus-circle"></i> Tạo khóa học mới</h3>
  </div>
  <div class="card-body">
    <form method="post" action="/instructor/courses" class="row g-3" id="courseForm" enctype="multipart/form-data">
      <div class="col-md-8">
        <label class="form-label">Tiêu đề khóa học *</label>
        <input name="title" class="form-control" required placeholder="Nhập tiêu đề khóa học" />
        <div class="form-text">Tiêu đề hấp dẫn sẽ thu hút nhiều học viên hơn</div>
      </div>
      <div class="col-md-4">
        <label class="form-label">Slug *</label>
        <input name="slug" class="form-control" required placeholder="unique-course-slug" />
        <div class="form-text">URL thân thiện cho khóa học</div>
      </div>
      
      <div class="col-md-6">
        <label class="form-label">Danh mục *</label>
        <select name="category_id" class="form-select" required>
          <option value="">-- Chọn danh mục --</option>
          {{#each categories}}
            <option value="{{this.id}}">{{this.name}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">Hình ảnh đại diện</label>
        <input type="file" name="hero_image" id="hero_image" class="form-control" accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"/>
        <div class="form-text">Chọn ảnh đại diện cho khóa học (JPG, PNG, GIF, WebP - tối đa 5MB)</div>
        <div id="image_preview" class="mt-2" style="display: none;">
          <img id="preview_img" src="" alt="Preview" style="max-width: 100%; max-height: 200px; border-radius: 8px; border: 1px solid #ddd;">
        </div>
      </div>
      
      <div class="col-12">
        <label class="form-label">Mô tả ngắn *</label>
        <textarea name="short_desc" rows="3" class="form-control" required placeholder="Mô tả ngắn gọn về khóa học..."></textarea>
        <div class="form-text">Mô tả ngắn sẽ hiển thị trong danh sách khóa học</div>
      </div>
      
      <div class="col-12">
        <label class="form-label">Mô tả chi tiết *</label>
        <textarea id="long_desc" name="long_desc" class="form-control" required></textarea>
        <div class="form-text">Mô tả chi tiết về nội dung khóa học, yêu cầu, lợi ích...</div>
      </div>
      
      <div class="col-md-4">
        <label class="form-label">Giá (VNĐ)</label>
        <input name="price" type="number" step="1000" min="0" class="form-control" placeholder="0"/>
        <div class="form-text">Để 0 nếu khóa học miễn phí</div>
      </div>
      <div class="col-md-4">
        <label class="form-label">Giá khuyến mãi (VNĐ)</label>
        <input name="promo_price" type="number" step="1000" min="0" class="form-control" placeholder="0"/>
        <div class="form-text">Giá đặc biệt (tùy chọn)</div>
      </div>
      <div class="col-md-4">
        <label class="form-label">Trạng thái</label>
        <select class="form-select" disabled>
          <option>Bản nháp</option>
        </select>
        <div class="form-text">Khóa học sẽ được lưu dưới dạng bản nháp</div>
      </div>
      
      <div class="col-12">
        <hr>
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-save"></i> Lưu bản nháp
        </button>
        <a href="/instructor/courses" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left"></i> Quay lại
        </a>
      </div>
    </form>
  </div>
</div>

<script>
// Auto-generate slug from title
document.querySelector('input[name="title"]').addEventListener('input', function() {
  const title = this.value;
  const slug = title
    .toLowerCase()
    .replace(/[^\p{L}\p{N}\s-]/gu, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '');
  document.querySelector('input[name="slug"]').value = slug;
});

// Preview uploaded image
document.getElementById('hero_image').addEventListener('change', function(e) {
  const file = e.target.files[0];
  const preview = document.getElementById('image_preview');
  const img = document.getElementById('preview_img');
  
  if (file) {
    // Check file type
    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
    if (!allowedTypes.includes(file.type)) {
      alert('Định dạng file không hỗ trợ! Vui lòng chọn file JPG, PNG, GIF hoặc WebP');
      e.target.value = '';
      preview.style.display = 'none';
      return;
    }
    
    // Check file size (5MB)
    const maxSize = 5 * 1024 * 1024;
    if (file.size > maxSize) {
      alert('File quá lớn! Vui lòng chọn file nhỏ hơn 5MB');
      e.target.value = '';
      preview.style.display = 'none';
      return;
    }
    
    const reader = new FileReader();
    reader.onload = function(e) {
      img.src = e.target.result;
      preview.style.display = 'block';
    };
    reader.readAsDataURL(file);
  } else {
    preview.style.display = 'none';
  }
});

</script>

<!-- TinyMCE CDN -->
<script src="https://cdn.tiny.cloud/1/tu2jfktfy9yrqap3g5gi2p1ljg4a7fe3apl675beevn0ox4o/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
// Initialize TinyMCE
tinymce.init({
  selector: '#long_desc',
  height: 400,
  menubar: false,
  plugins: [
    'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
    'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
    'insertdatetime', 'media', 'table', 'help', 'wordcount'
  ],
  toolbar: 'undo redo | blocks | ' +
    'bold italic forecolor | alignleft aligncenter ' +
    'alignright alignjustify | bullist numlist outdent indent | ' +
    'removeformat | help',
  content_style: 'body { font-family: -apple-system, BlinkMacSystemFont, San Francisco, Segoe UI, Roboto, Helvetica Neue, sans-serif; font-size: 14px; }',
  setup: function (editor) {
    editor.on('change', function () {
      editor.save();
    });
  }
});

// Update form validation to work with TinyMCE
document.getElementById('courseForm').addEventListener('submit', function(e) {
  // Sync TinyMCE content before validation
  if (tinymce.get('long_desc')) {
    tinymce.get('long_desc').save();
  }
  
  const title = document.querySelector('input[name="title"]').value.trim();
  const slug = document.querySelector('input[name="slug"]').value.trim();
  const category = document.querySelector('select[name="category_id"]').value;
  const shortDesc = document.querySelector('textarea[name="short_desc"]').value.trim();
  const longDesc = document.querySelector('textarea[name="long_desc"]').value.trim();
  
  console.log('Form validation:', { title, slug, category, shortDesc, longDesc });
  
  if (!title || !slug || !category || !shortDesc || !longDesc) {
    e.preventDefault();
    alert('Vui lòng điền đầy đủ các trường bắt buộc!');
    return false;
  }
  
  if (slug.length < 3) {
    e.preventDefault();
    alert('Slug phải có ít nhất 3 ký tự!');
    return false;
  }
  
  console.log('Form validation passed, submitting...');
});
</script>