<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Báo cáo chi tiết</h1>
        <div class="btn-group" role="group">
          <button type="button" class="btn btn-outline-primary active">7 ngày</button>
          <button type="button" class="btn btn-outline-primary">30 ngày</button>
          <button type="button" class="btn btn-outline-primary">90 ngày</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tổng quan -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h4 class="mb-0">{{courseStats.total}}</h4>
              <p class="mb-0">Tổng khóa học</p>
            </div>
            <div class="align-self-center">
              <i class="bi bi-book display-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h4 class="mb-0">{{studentStats.unique_students}}</h4>
              <p class="mb-0">Học viên</p>
            </div>
            <div class="align-self-center">
              <i class="bi bi-people display-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h4 class="mb-0">{{revenueStats.total_enrollments}}</h4>
              <p class="mb-0">Lượt đăng ký</p>
            </div>
            <div class="align-self-center">
              <i class="bi bi-graph-up display-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-info text-white">
        <div class="card-body">
          <div class="d-flex justify-content-between">
            <div>
              <h4 class="mb-0">{{formatCurrency revenueStats.total_revenue}}</h4>
              <p class="mb-0">Doanh thu</p>
            </div>
            <div class="align-self-center">
              <i class="bi bi-currency-dollar display-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <!-- Biểu đồ doanh thu -->
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Biểu đồ doanh thu theo thời gian</h5>
        </div>
        <div class="card-body">
          <div class="text-center py-5">
            <i class="bi bi-bar-chart display-1 text-muted"></i>
            <p class="text-muted mt-3">Biểu đồ sẽ được hiển thị ở đây</p>
            <small class="text-muted">Tính năng đang phát triển</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Thống kê chi tiết -->
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Thống kê khóa học</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <div class="d-flex justify-content-between">
              <span>Đã xuất bản:</span>
              <strong class="text-success">{{courseStats.published}}</strong>
            </div>
          </div>
          <div class="mb-3">
            <div class="d-flex justify-content-between">
              <span>Bản nháp:</span>
              <strong class="text-warning">{{courseStats.draft}}</strong>
            </div>
          </div>
          <div class="mb-3">
            <div class="d-flex justify-content-between">
              <span>Tỷ lệ xuất bản:</span>
              <strong>
                {{#if courseStats.total}}
                  {{round (multiply (divide courseStats.published courseStats.total) 100)}}%
                {{else}}
                  0%
                {{/if}}
              </strong>
            </div>
          </div>
          <hr>
          <div class="mb-3">
            <div class="d-flex justify-content-between">
              <span>Doanh thu trung bình:</span>
              <strong>
                {{#if revenueStats.total_enrollments}}
                  {{formatCurrency (divide revenueStats.total_revenue revenueStats.total_enrollments)}}
                {{else}}
                  ₫0
                {{/if}}
              </strong>
            </div>
          </div>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header">
          <h5 class="mb-0">Top khóa học</h5>
        </div>
        <div class="card-body">
          <div class="text-center py-3">
            <i class="bi bi-trophy display-4 text-muted"></i>
            <p class="text-muted mt-2">Danh sách top khóa học</p>
            <small class="text-muted">Tính năng đang phát triển</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bảng chi tiết -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Chi tiết khóa học</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Khóa học</th>
                  <th>Trạng thái</th>
                  <th>Học viên</th>
                  <th>Doanh thu</th>
                  <th>Đánh giá</th>
                  <th>Ngày tạo</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td colspan="6" class="text-center py-4">
                    <i class="bi bi-table display-4 text-muted"></i>
                    <p class="text-muted mt-2">Bảng chi tiết khóa học</p>
                    <small class="text-muted">Tính năng đang phát triển</small>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
