<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Cài đặt hồ sơ</h1>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Thông tin cá nhân</h5>
        </div>
        <div class="card-body">
          {{#if error}}
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{error}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
          {{/if}}
          {{#if success}}
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{success}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
          {{/if}}
          <form method="POST" action="/instructor/profile">
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="full_name" class="form-label">Họ và tên</label>
                  <input type="text" class="form-control" id="full_name" name="name" value="{{user.name}}" required>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="email" class="form-label">Email</label>
                  <input type="email" class="form-control" id="email" name="email" value="{{user.email}}" required>
                </div>
              </div>
            </div>
            
            <div class="mb-3">
              <label for="role" class="form-label">Vai trò</label>
              <input type="text" class="form-control" id="role" value="{{user.role}}" readonly>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="phone" class="form-label">Số điện thoại</label>
                  <input type="text" class="form-control" id="phone" name="phone" value="{{user.phone}}" placeholder="Ví dụ: 0123456789">
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="experience_years" class="form-label">Năm kinh nghiệm</label>
                  <input type="number" class="form-control" id="experience_years" name="experience_years" value="{{user.experience_years}}" placeholder="Ví dụ: 5" min="0">
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label for="specialization" class="form-label">Chuyên ngành</label>
              <input type="text" class="form-control" id="specialization" name="specialization" value="{{user.specialization}}" placeholder="Ví dụ: Web Development, Data Science...">
            </div>

            <div class="mb-3">
              <label for="bio" class="form-label">Giới thiệu bản thân</label>
              <textarea class="form-control" id="bio" name="bio" rows="4" placeholder="Viết vài dòng giới thiệu về bản thân...">{{user.bio}}</textarea>
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">Cập nhật hồ sơ</button>
              <a href="/instructor/dashboard" class="btn btn-outline-secondary">Hủy</a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Ảnh đại diện</h5>
        </div>
        <div class="card-body text-center">
          <div class="mb-3">
            {{#if user.id}}
            <img src="/images/instructor/{{user.id}}.jpg" class="rounded-circle border shadow-sm" alt="Avatar" 
                 width="150" height="150" style="object-fit: cover;" 
                 onerror="this.src='https://via.placeholder.com/150x150?text=Avatar'">
            {{else}}
            <img src="https://via.placeholder.com/150x150?text=Avatar" class="rounded-circle" alt="Avatar" width="150" height="150">
            {{/if}}
          </div>
          <form method="POST" action="/instructor/profile/avatar" enctype="multipart/form-data" id="avatarForm">
            <input type="file" name="avatar" id="avatarInput" accept="image/jpeg,image/jpg,image/png,image/webp" style="display: none;" onchange="document.getElementById('avatarForm').submit()">
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('avatarInput').click()">Thay đổi ảnh</button>
          </form>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header">
          <h5 class="mb-0">Thông tin bổ sung</h5>
        </div>
        <div class="card-body">
          <div class="mb-2">
            <strong>ID:</strong> {{user.id}}
          </div>
          <div class="mb-2">
            <strong>Ngày tạo:</strong> 
            {{#if user.created_at}}
            <span>{{formatDate user.created_at}}</span>
            {{else}}
            <span class="text-muted">Chưa có thông tin</span>
            {{/if}}
          </div>
          <div class="mb-2">
            <strong>Trạng thái:</strong> 
            <span class="badge bg-success">Hoạt động</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
