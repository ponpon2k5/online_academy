<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Cài đặt hồ sơ</h1>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Thông tin cá nhân</h5>
        </div>
        <div class="card-body">
          <form>
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="full_name" class="form-label">Họ và tên</label>
                  <input type="text" class="form-control" id="full_name" value="{{user.full_name}}" readonly>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="email" class="form-label">Email</label>
                  <input type="email" class="form-control" id="email" value="{{user.email}}" readonly>
                </div>
              </div>
            </div>
            
            <div class="mb-3">
              <label for="role" class="form-label">Vai trò</label>
              <input type="text" class="form-control" id="role" value="{{user.role}}" readonly>
            </div>

            <div class="mb-3">
              <label for="bio" class="form-label">Giới thiệu bản thân</label>
              <textarea class="form-control" id="bio" rows="4" placeholder="Viết vài dòng giới thiệu về bản thân..."></textarea>
            </div>

            <div class="mb-3">
              <label for="specialization" class="form-label">Chuyên môn</label>
              <input type="text" class="form-control" id="specialization" placeholder="Ví dụ: Web Development, Data Science...">
            </div>

            <div class="mb-3">
              <label for="experience" class="form-label">Kinh nghiệm</label>
              <input type="text" class="form-control" id="experience" placeholder="Ví dụ: 5 năm kinh nghiệm...">
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">Cập nhật hồ sơ</button>
              <button type="button" class="btn btn-outline-secondary">Hủy</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Ảnh đại diện</h5>
        </div>
        <div class="card-body text-center">
          <div class="mb-3">
            <img src="https://via.placeholder.com/150x150?text=Avatar" class="rounded-circle" alt="Avatar" width="150" height="150">
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm">Thay đổi ảnh</button>
        </div>
      </div>

      <div class="card mt-3">
        <div class="card-header">
          <h5 class="mb-0">Thông tin bổ sung</h5>
        </div>
        <div class="card-body">
          <div class="mb-2">
            <strong>ID:</strong> {{user.id}}
          </div>
          <div class="mb-2">
            <strong>Ngày tạo:</strong> <span class="text-muted">Chưa có thông tin</span>
          </div>
          <div class="mb-2">
            <strong>Trạng thái:</strong> 
            <span class="badge bg-success">Hoạt động</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
