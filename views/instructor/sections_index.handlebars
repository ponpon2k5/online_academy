<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0"><i class="bi bi-list-ol"></i> Quản lý chương - {{course.title}}</h3>
  <a href="/instructor/courses" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Quay lại
  </a>
</div>

<!-- Form thêm chương mới -->
<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Thêm chương mới</h5>
  </div>
  <div class="card-body">
    <form class="row g-3" method="post" action="/instructor/courses/{{course.id}}/sections">
      <div class="col-md-8">
        <label class="form-label">Tên chương *</label>
        <input name="title" class="form-control" placeholder="Nhập tên chương..." required/>
      </div>
      <div class="col-md-2">
        <label class="form-label">Thứ tự</label>
        <input name="sort_order" type="number" class="form-control" placeholder="0" min="0"/>
      </div>
      <div class="col-md-2">
        <label class="form-label">&nbsp;</label>
        <button class="btn btn-primary w-100">
          <i class="bi bi-plus"></i> Thêm
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Danh sách chương -->
{{#if sections.length}}
<div class="row">
  {{#each sections}}
  <div class="col-md-6 col-lg-4 mb-3">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h6 class="card-title mb-0">{{this.title}}</h6>
          <span class="badge bg-primary">{{this.sort_order}}</span>
        </div>
        <div class="mb-2">
          <small class="text-muted">
            <i class="bi bi-play-circle"></i> 
            {{#if this.lessonCount}}
              {{this.lessonCount}} bài học
            {{else}}
              Chưa có bài học
            {{/if}}
          </small>
        </div>
        <div class="d-grid gap-2">
          <a href="/instructor/courses/{{../course.id}}/lessons/new?section={{this.id}}" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Thêm bài học
          </a>
          <a href="/instructor/courses/{{../course.id}}/sections/{{this.id}}/lessons" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list"></i> Xem bài học
          </a>
        </div>
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<div class="text-center py-4">
  <i class="bi bi-list-ol display-4 text-muted"></i>
  <h5 class="mt-3 text-muted">Chưa có chương nào</h5>
  <p class="text-muted">Thêm chương đầu tiên để bắt đầu tạo nội dung khóa học</p>
</div>
{{/if}}

<!-- Bài học không thuộc chương nào -->
{{#if lessonsWithoutSection.length}}
<div class="mt-4">
  <div class="card">
    <div class="card-header">
      <h5 class="mb-0"><i class="bi bi-play-circle"></i> Bài học không thuộc chương</h5>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Thứ tự</th>
              <th>Tên bài học</th>
              <th>Thời lượng</th>
              <th>Xem trước</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody>
            {{#each lessonsWithoutSection}}
            <tr>
              <td>
                <span class="badge bg-secondary">{{this.sort_order}}</span>
              </td>
              <td>
                <strong>{{this.lesson}}</strong>
              </td>
              <td>
                {{#if this.duration_seconds}}
                  {{formatDuration this.duration_seconds}}
                {{else}}
                  <span class="text-muted">Chưa xác định</span>
                {{/if}}
              </td>
              <td>
                {{#if this.is_preview}}
                  <span class="badge bg-success">Có</span>
                {{else}}
                  <span class="badge bg-secondary">Không</span>
                {{/if}}
              </td>
              <td>
                <div class="btn-group btn-group-sm" role="group">
                  <a href="/courses/preview-lessons/{{../course.id}}?lesson={{this.id}}" 
                     class="btn btn-outline-primary" 
                     target="_blank"
                     title="Xem bài học">
                    <i class="bi bi-play-circle"></i>
                  </a>
                  <button class="btn btn-outline-secondary" 
                          onclick="editLesson('{{this.id}}')"
                          title="Sửa bài học">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <button class="btn btn-outline-danger" 
                          onclick="deleteLesson('{{this.id}}', '{{this.lesson}}')"
                          title="Xóa bài học">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{{/if}}

<!-- Nút thêm bài học trực tiếp (không thuộc chương nào) -->
<div class="mt-4">
  <a href="/instructor/courses/{{course.id}}/lessons/new" class="btn btn-success">
    <i class="bi bi-plus-circle"></i> Thêm bài học (không thuộc chương)
  </a>
</div>

