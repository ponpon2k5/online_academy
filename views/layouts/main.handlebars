<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
  
  <!-- Minimal Custom Styles -->
  <style>
    .navbar-brand img {
      transition: transform 0.2s ease;
    }
    .navbar-brand:hover img {
      transform: scale(1.05);
    }
    .search-icon {
      position: absolute;
      left: 15px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
    }
  </style>
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg bg-white shadow-lg sticky-top">
    <div class="container-fluid px-4">
      <!-- Logo -->
      <a class="navbar-brand text-dark fw-bold" href="/">
        <img src="/images/logo.svg" alt="Logo" height="30" class="me-2">
        Online Academy
      </a>

      <!-- Toggle button for mobile -->
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <!-- Navbar content -->
      <div class="collapse navbar-collapse" id="navbarNav">
        <!-- Nút Explore -->
        <a class="nav-link text-dark fw-semibold me-3" href="/courses/view-courses">
          <i class="bi bi-compass me-1"></i>Explore
        </a>

        <!-- Ô tìm kiếm -->
        <form class="d-flex flex-grow-1 mx-3 position-relative" method="get" action="/courses/search" role="search">
          <i class="bi bi-search search-icon text-muted"></i>
          <input
            class="form-control rounded-pill ps-5 pe-4"
            type="search"
            placeholder="Tìm kiếm khóa học, giảng viên..."
            aria-label="Search"
            name="q" />
          <button class="btn btn-success rounded-pill ms-2 px-4" type="submit">
            <i class="bi bi-search me-1"></i>
          </button>
        </form>

        <!-- Menu bên phải -->
        <ul class="navbar-nav ms-auto align-items-center">
          {{#if (and isAuthenticated (eq authUser.role 'instructor'))}}
          <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" href="/instructor/dashboard">
              <i class="bi bi-mortarboard me-1"></i>Teach
            </a>
          </li>
          {{else if (and isAuthenticated (eq authUser.role 'admin'))}}
          <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" href="/admin/dashboard">
              <i class="bi bi-shield-check me-1"></i>Admin
            </a>
          </li>
          {{else if isAuthenticated}}
          <li class="nav-item">
            <a class="nav-link text-dark fw-semibold position-relative" href="/account/shopping-cart">
              <i class="bi bi-cart fs-5"></i>
              {{#if cartCount}}
              <span class="position-absolute badge rounded-circle bg-danger text-white" style="font-size: 0.65rem; top: -2px; right: -2px; min-width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; line-height: 1;">
                {{cartCount}}
              </span>
              {{/if}}
            </a>
          </li>
          {{/if}}

          {{#if isAuthenticated}}
          <!-- Đã đăng nhập -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark fw-semibold d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle me-2 fs-5"></i>
              <span class="d-none d-md-inline">{{authUser.name}}</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
              {{#if (eq authUser.role 'instructor')}}
              <li><a class="dropdown-item py-2" href="/instructor/dashboard">
                <i class="bi bi-mortarboard text-primary me-2"></i>Instructor Dashboard
              </a></li>
              <li><a class="dropdown-item py-2" href="/instructor/courses">
                <i class="bi bi-book text-primary me-2"></i>My Courses
              </a></li>
              <li><hr class="dropdown-divider"></li>
              {{else if (eq authUser.role 'admin')}}
              <li><a class="dropdown-item py-2" href="/admin/dashboard">
                <i class="bi bi-shield-check text-primary me-2"></i>Admin Dashboard
              </a></li>
              <li><a class="dropdown-item py-2" href="/admin/courses">
                <i class="bi bi-book text-primary me-2"></i>Manage Courses
              </a></li>
              <li><a class="dropdown-item py-2" href="/admin/users">
                <i class="bi bi-people text-primary me-2"></i>Manage Users
              </a></li>
              <li><hr class="dropdown-divider"></li>
              {{else if (eq authUser.role 'student')}}
              <li><a class="dropdown-item py-2" href="/student/profile-favor-courses">
                <i class="bi bi-person text-primary me-2"></i>Trang cá nhân
              </a></li>
              {{/if}}
              <li><a class="dropdown-item py-2" href="/account/change-password">
                <i class="bi bi-key text-primary me-2"></i>Đổi mật khẩu
              </a></li>
              {{#if (eq authUser.role 'instructor')}}
              <li><a class="dropdown-item py-2" href="/account/shopping-cart">
                <i class="bi bi-cart text-primary me-2"></i>Giỏ hàng
              </a></li>
              {{/if}}
              {{#if (eq authUser.role 'admin')}}
              <li><a class="dropdown-item py-2" href="/account/shopping-cart">
                <i class="bi bi-cart text-primary me-2"></i>Giỏ hàng
              </a></li>
              {{/if}}
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item py-2 text-danger" href="javascript: document.querySelector('#frmSignout').submit()">
                  <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                </a>
              </li>
            </ul>
            <form id="frmSignout" action="/account/signout" method="post"></form>
          </li>
          {{else}}
          <!-- Chưa đăng nhập -->
          <li class="nav-item me-2">
            <a class="btn btn-outline-dark rounded-pill px-3" href="/account/signin">
              <i class="bi bi-box-arrow-in-right me-1"></i>Log in
            </a>
          </li>
          <li class="nav-item">
            <a class="btn btn-primary rounded-pill px-3 fw-semibold" href="/account/signup">
              <i class="bi bi-person-plus me-1"></i>Sign up
            </a>
          </li>
          {{/if}}
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <main class="min-vh-100">
    {{{body}}}
  </main>

  <!-- Footer -->
  {{> footer}}

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.plyr.io/3.7.8/plyr.polyfilled.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      if (document.querySelector("#player")) {
        const player = new Plyr("#player");
      }
      
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });
    });
  </script>

  {{{_sections.js}}}
</body>
</html>
