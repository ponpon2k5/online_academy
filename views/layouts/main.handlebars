<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top">
    <div class="container-fluid px-4">
      <!-- Logo -->
      <a class="navbar-brand" href="/">
        <img src="/images/logo.svg" alt="Logo" height="30">
      </a>

      <!-- Nút Explore -->
      <a class="nav-link" href="/courses/view-courses">Explore</a>

      <!-- Ô tìm kiếm -->
      <form class="d-flex flex-grow-1 mx-3" method="get" action="/courses/search" role="search">
        <input
          class="form-control rounded-pill"
          type="search"
          placeholder="Tìm kiếm nội dung bất kỳ"
          aria-label="Search"
          name="q" />
        <button class="btn rounded-pill btn-outline-success ms-2" type="submit">
          <i class="bi bi-search"></i> Tìm kiếm
        </button>
      </form>

      <!-- Menu bên phải -->
      <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item">
          <a class="nav-link" href="#">Udemy Business</a>
        </li>
        {{#if (and isAuthenticated (eq authUser.role 'instructor'))}}
        <li class="nav-item">
          <a class="nav-link" href="/instructor/dashboard">Teach on Academy</a>
        </li>
        {{else if (and isAuthenticated (eq authUser.role 'admin'))}}
        <li class="nav-item">
          <a class="nav-link" href="/admin/dashboard">Admin Panel</a>
        </li>
        {{else}}
        <li class="nav-item">
          <a class="nav-link" href="#">Teach on Academy</a>
        </li>
        {{/if}}
        <li class="nav-item">
          <a class="nav-link" href="/courses/view-courses"><i class="bi bi-cart"></i></a>
        </li>

        {{#if isAuthenticated}}
        <!-- Đã đăng nhập -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Welcome, <b>{{authUser.name}}</b>
          </a>
          <ul class="dropdown-menu">
            {{#if (eq authUser.role 'instructor')}}
            <li><a class="dropdown-item" href="/instructor/dashboard"><i class="bi bi-mortarboard"></i> Instructor Dashboard</a></li>
            <li><a class="dropdown-item" href="/instructor/courses"><i class="bi bi-book"></i> My Courses</a></li>
            <li><hr class="dropdown-divider"></li>
            {{else if (eq authUser.role 'admin')}}
            <li><a class="dropdown-item" href="/admin/dashboard"><i class="bi bi-shield-check"></i> Admin Dashboard</a></li>
            <li><a class="dropdown-item" href="/admin/courses"><i class="bi bi-book"></i> Manage Courses</a></li>
            <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people"></i> Manage Users</a></li>
            <li><hr class="dropdown-divider"></li>
            {{else}}
            <li><a class="dropdown-item" href="/student/profile-favor-courses"><i class="bi bi-person"></i>Trang cá nhân</a></li>
            {{/if}}
            <li><a class="dropdown-item" href="/account/change-password"><i class="bi bi-key"></i>Đổi mật khẩu</a></li>
            <li>
              <a class="dropdown-item text-danger" href="javascript: document.querySelector('#frmSignout').submit()">
                <i class="bi bi-box-arrow-right"></i> Sign Out
              </a>
            </li>
          </ul>
          <form id="frmSignout" action="/account/signout" method="post"></form>
        </li>
        {{else}}
        <!-- Chưa đăng nhập -->
        <li class="nav-item">
          <a class="btn btn-outline-dark me-2" href="/account/signin">Log in</a>
        </li>
        <li class="nav-item">
          <a class="btn btn-primary" href="/account/signup">Sign up</a>
        </li>
        {{/if}}
      </ul>
    </div>
  </nav>

  <!-- Main content -->
  <main>
    {{{body}}}
  </main>

  <!-- Footer -->
  {{> footer}}

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.plyr.io/3.7.8/plyr.polyfilled.js"></script>
  
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      if (document.querySelector("#player")) {
        const player = new Plyr("#player");
      }
    });
  </script>

  {{{_sections.js}}}
</body>
</html>
