<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0"><i class="bi bi-book"></i> Quản lý khóa học</h3>
  <div class="btn-group" role="group">
    <button type="button" class="btn btn-outline-primary" onclick="filterCourses('all')">Tất cả</button>
    <button type="button" class="btn btn-outline-success" onclick="filterCourses('published')">Đã xuất bản</button>
    <button type="button" class="btn btn-outline-warning" onclick="filterCourses('draft')">Bản nháp</button>
    <button type="button" class="btn btn-outline-danger" onclick="filterCourses('removed')">Đã gỡ bỏ</button>
  </div>
</div>

{{#if courses.length}}
<div class="row">
  {{#each courses}}
  <div class="col-md-6 col-lg-4 mb-4 course-card" data-status="{{this.status}}">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h5 class="card-title">{{this.title}}</h5>
          <span class="badge {{#if (eq this.status 'published')}}bg-success{{else if (eq this.status 'draft')}}bg-warning{{else}}bg-danger{{/if}}">
            {{#if (eq this.status 'published')}}Đã xuất bản
            {{else if (eq this.status 'draft')}}Bản nháp
            {{else}}Đã gỡ bỏ{{/if}}
          </span>
        </div>
        
        <p class="text-muted small mb-2">
          <i class="bi bi-person"></i> {{this.instructor}}
        </p>
        
        <p class="text-muted small mb-3">
          <i class="bi bi-calendar"></i> {{formatDate this.created_at}}
        </p>
        
        <div class="d-grid gap-2">
          <!-- Nút xem khóa học - nổi bật -->
          <a href="/courses/{{this.id}}" class="btn btn-primary btn-sm" target="_blank">
            <i class="bi bi-eye"></i> Xem khóa học
          </a>
          
          <!-- Nhóm nút hành động admin -->
          <div class="d-flex gap-1">
            {{#if (eq this.status "published")}}
            <!-- Khóa học đã xuất bản: có thể chuyển thành bản nháp hoặc gỡ bỏ -->
            <form method="post" action="/admin/courses/{{this.id}}/draft" class="flex-fill" onsubmit="return confirm('Bạn có chắc muốn chuyển khóa học này thành bản nháp?')">
              <button type="submit" class="btn btn-outline-warning btn-sm w-100">
                <i class="bi bi-file-earmark-text"></i> Bản nháp
              </button>
            </form>
            <form method="post" action="/admin/courses/{{this.id}}/remove" class="flex-fill" onsubmit="return confirm('Bạn có chắc muốn gỡ bỏ khóa học này?')">
              <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                <i class="bi bi-trash"></i> Gỡ bỏ
              </button>
            </form>
            {{else if (eq this.status "draft")}}
            <!-- Khóa học bản nháp: có thể xuất bản hoặc gỡ bỏ -->
            <form method="post" action="/admin/courses/{{this.id}}/publish" class="flex-fill" onsubmit="return confirm('Bạn có chắc muốn xuất bản khóa học này?')">
              <button type="submit" class="btn btn-outline-success btn-sm w-100">
                <i class="bi bi-check-circle"></i> Xuất bản
              </button>
            </form>
            <form method="post" action="/admin/courses/{{this.id}}/remove" class="flex-fill" onsubmit="return confirm('Bạn có chắc muốn gỡ bỏ khóa học này?')">
              <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                <i class="bi bi-trash"></i> Gỡ bỏ
              </button>
            </form>
            {{else if (eq this.status "removed")}}
            <!-- Khóa học đã gỡ bỏ: có thể khôi phục về xuất bản -->
            <form method="post" action="/admin/courses/{{this.id}}/publish" class="flex-fill" onsubmit="return confirm('Bạn có chắc muốn khôi phục và xuất bản khóa học này?')">
              <button type="submit" class="btn btn-outline-success btn-sm w-100">
                <i class="bi bi-arrow-clockwise"></i> Khôi phục
              </button>
            </form>
            <button class="btn btn-outline-secondary btn-sm flex-fill" disabled>
              <i class="bi bi-ban"></i> Đã gỡ bỏ
            </button>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<div class="text-center py-5">
  <i class="bi bi-book display-1 text-muted"></i>
  <h4 class="mt-3 text-muted">Chưa có khóa học nào</h4>
  <p class="text-muted">Hệ thống chưa có khóa học nào được tạo</p>
</div>
{{/if}}

<script>
function filterCourses(status) {
  const cards = document.querySelectorAll('.course-card');
  // Chỉ select các button trong filter group, không ảnh hưởng đến button trong card
  const filterButtons = document.querySelectorAll('.d-flex .btn-group button');
  
  // Reset all filter buttons to their default outline state
  filterButtons.forEach(btn => {
    // Remove all possible classes first
    btn.classList.remove('active', 'btn-primary', 'btn-success', 'btn-warning', 'btn-danger', 
                        'btn-outline-primary', 'btn-outline-success', 'btn-outline-warning', 'btn-outline-danger');
    
    // Get button text to determine correct outline class
    const buttonText = btn.textContent.trim();
    if (buttonText === 'Tất cả') {
      btn.classList.add('btn-outline-primary');
    } else if (buttonText === 'Đã xuất bản') {
      btn.classList.add('btn-outline-success');
    } else if (buttonText === 'Bản nháp') {
      btn.classList.add('btn-outline-warning');
    } else if (buttonText === 'Đã gỡ bỏ') {
      btn.classList.add('btn-outline-danger');
    }
  });
  
  // Set active button
  const activeBtn = document.querySelector(`button[onclick="filterCourses('${status}')"]`);
  if (activeBtn) {
    // Remove outline class and add solid class for active state
    activeBtn.classList.remove('btn-outline-primary', 'btn-outline-success', 'btn-outline-warning', 'btn-outline-danger');
    activeBtn.classList.add('active');
    
    const buttonText = activeBtn.textContent.trim();
    if (buttonText === 'Tất cả') {
      activeBtn.classList.add('btn-primary');
    } else if (buttonText === 'Đã xuất bản') {
      activeBtn.classList.add('btn-success');
    } else if (buttonText === 'Bản nháp') {
      activeBtn.classList.add('btn-warning');
    } else if (buttonText === 'Đã gỡ bỏ') {
      activeBtn.classList.add('btn-danger');
    }
  }
  
  // Filter cards
  cards.forEach(card => {
    if (status === 'all' || card.dataset.status === status) {
      card.style.display = 'block';
    } else {
      card.style.display = 'none';
    }
  });
}

// Set default active button on page load
document.addEventListener('DOMContentLoaded', function() {
  filterCourses('all');
});
</script>
