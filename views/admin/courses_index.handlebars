<h3 class="mb-3">All Courses</h3>
<table class="table table-hover align-middle">
  <thead><tr><th>Title</th><th>Instructor</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead>
  <tbody>
  {{#each courses}}
    <tr>
      <td>{{this.title}}</td>
      <td>{{this.instructor}}</td>
      <td><span class="badge bg-secondary">{{this.status}}</span></td>
      <td>{{this.created_at}}</td>
      <td>
        {{#if (ne this.status "removed")}}
        <form method="post" action="/admin/courses/{{this.id}}/remove" onsubmit="return confirm('Remove this course?')" style="display:inline">
          <button class="btn btn-sm btn-danger">Remove</button>
        </form>
        {{/if}}
      </td>
    </tr>
  {{/each}}
  </tbody>
</table>
