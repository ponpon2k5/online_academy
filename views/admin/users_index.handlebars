<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0"><i class="bi bi-people"></i> Quản lý người dùng</h3>
  <div class="d-flex gap-2">
    <div class="btn-group" role="group">
      <button type="button" class="btn {{#if (eq filters.status 'all')}}btn-primary{{else}}btn-outline-primary{{/if}}" onclick="applyFilter('status', 'all')">
        <i class="bi bi-list"></i> Tất cả
      </button>
      <button type="button" class="btn {{#if (eq filters.status 'active')}}btn-success{{else}}btn-outline-success{{/if}}" onclick="applyFilter('status', 'active')">
        <i class="bi bi-check-circle"></i> Đang hoạt động
      </button>
      <button type="button" class="btn {{#if (eq filters.status 'locked')}}btn-danger{{else}}btn-outline-danger{{/if}}" onclick="applyFilter('status', 'locked')">
        <i class="bi bi-lock"></i> Đã khóa
      </button>
    </div>
    <div class="btn-group" role="group">
      <button type="button" class="btn {{#if (eq filters.role 'all')}}btn-primary{{else}}btn-outline-primary{{/if}}" onclick="applyFilter('role', 'all')">Tất cả</button>
      <button type="button" class="btn {{#if (eq filters.role 'student')}}btn-success{{else}}btn-outline-success{{/if}}" onclick="applyFilter('role', 'student')">Học viên</button>
      <button type="button" class="btn {{#if (eq filters.role 'instructor')}}btn-info{{else}}btn-outline-info{{/if}}" onclick="applyFilter('role', 'instructor')">Giảng viên</button>
      <button type="button" class="btn {{#if (eq filters.role 'admin')}}btn-warning{{else}}btn-outline-warning{{/if}}" onclick="applyFilter('role', 'admin')">Quản trị</button>
    </div>
  </div>
</div>

<div class="mb-3">
  <a href="/admin/users/new-instructor" class="btn btn-primary">
    <i class="bi bi-person-plus"></i> Tạo giảng viên mới
  </a>
</div>

{{#if users.length}}
<div class="row">
  {{#each users}}
  <div class="col-md-6 col-lg-4 mb-4 user-card" data-role="{{this.role}}" data-status="{{#if this.is_active}}active{{else}}locked{{/if}}" data-user-id="{{this.id}}">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          <div class="avatar {{#if this.is_active}}bg-primary{{else}}bg-secondary{{/if}} text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
            <i class="bi bi-person-fill"></i>
          </div>
          <div>
            <h6 class="mb-0">{{this.name}} {{#unless this.is_active}}<small class="text-muted">(Đã khóa)</small>{{/unless}}</h6>
            <span class="badge {{#if (eq this.role 'admin')}}bg-warning{{else if (eq this.role 'instructor')}}bg-info{{else}}bg-success{{/if}}">
              {{#if (eq this.role 'admin')}}Quản trị viên
              {{else if (eq this.role 'instructor')}}Giảng viên
              {{else}}Học viên{{/if}}
            </span>
            {{#unless this.is_active}}
            <span class="badge bg-danger ms-1">Đã khóa</span>
            {{/unless}}
          </div>
        </div>
        
        <div class="mb-2">
          <small class="text-muted">
            <i class="bi bi-envelope"></i> {{this.email}}
          </small>
        </div>
        
        <div class="mb-3">
          <small class="text-muted">
            <i class="bi bi-calendar"></i> Tham gia: {{formatDate this.created_at}}
          </small>
        </div>
        
        <div class="d-grid gap-2">
          <div class="d-flex gap-1">
            {{#if (eq this.role 'instructor')}}
            <a href="/admin/users/{{this.id}}/courses" class="btn btn-outline-primary btn-sm flex-fill">
              <i class="bi bi-book"></i> Khóa học
            </a>
            {{else if (eq this.role 'student')}}
            <a href="/admin/users/{{this.id}}/profile" class="btn btn-outline-success btn-sm flex-fill">
              <i class="bi bi-person-check"></i> Hồ sơ
            </a>
            {{/if}}
            <button class="btn btn-outline-info btn-sm flex-fill" onclick="viewUserDetails('{{this.id}}')">
              <i class="bi bi-eye"></i> Chi tiết
            </button>
          </div>
          
          {{#unless (eq this.role 'admin')}}
          <div class="d-flex gap-1">
            {{#if this.is_active}}
            <form action="/admin/users/{{this.id}}/deactivate" method="POST" class="flex-fill" onsubmit="return confirm('Bạn có chắc muốn khóa tài khoản này?');">
              <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                <i class="bi bi-lock"></i> Khóa tài khoản
              </button>
            </form>
            {{else}}
            <form action="/admin/users/{{this.id}}/activate" method="POST" class="flex-fill" onsubmit="return confirm('Bạn có chắc muốn mở khóa tài khoản này?');">
              <button type="submit" class="btn btn-outline-success btn-sm w-100">
                <i class="bi bi-unlock"></i> Mở khóa
              </button>
            </form>
            {{/if}}
          </div>
          {{/unless}}
          
          <!-- Đã bỏ nút xóa theo yêu cầu -->
        </div>
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<div class="text-center py-5">
  <i class="bi bi-people display-1 text-muted"></i>
  <h4 class="mt-3 text-muted">Chưa có người dùng nào</h4>
  <p class="text-muted">Hệ thống chưa có người dùng nào được đăng ký</p>
</div>
{{/if}}

<!-- Modal chi tiết người dùng -->
<div class="modal fade" id="userDetailsModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Chi tiết người dùng</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="userDetailsContent">
        <!-- Nội dung sẽ được load bằng JavaScript -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>

<script>
// Áp dụng filter và reload trang với query params
function applyFilter(filterType, value) {
  const url = new URL(window.location.href);
  
  // Nếu chọn "all", xóa filter đó khỏi URL
  if (value === 'all') {
    url.searchParams.delete(filterType);
  } else {
    // Giữ nguyên các filter khác và cập nhật filter được chọn
    url.searchParams.set(filterType, value);
  }
  
  // Reload trang với filter mới
  window.location.href = url.toString();
}

// Filter theo client-side (backup - không cần thiết nếu đã dùng server-side filter)
function filterUsersClient(role) {
  const cards = document.querySelectorAll('.user-card');
  
  cards.forEach(card => {
    if (role === 'all' || card.dataset.role === role) {
      card.style.display = 'block';
    } else {
      card.style.display = 'none';
    }
  });
}

function viewUserDetails(userId) {
  // Tìm user data từ DOM
  const userCard = document.querySelector(`[data-user-id="${userId}"]`);
  if (!userCard) {
    document.getElementById('userDetailsContent').innerHTML = `
      <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i> Không tìm thấy thông tin người dùng
      </div>
    `;
  } else {
    const userName = userCard.querySelector('h6').textContent;
    const userEmail = userCard.querySelector('.text-muted').textContent.replace('📧 ', '');
    const userRole = userCard.querySelector('.badge').textContent.trim();
    const joinDate = userCard.querySelectorAll('.text-muted')[1].textContent.replace('📅 Tham gia: ', '');
    
    document.getElementById('userDetailsContent').innerHTML = `
      <div class="row">
        <div class="col-md-4">
          <div class="text-center">
            <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
              <i class="bi bi-person-fill fs-1"></i>
            </div>
            <h5>${userName}</h5>
            <span class="badge ${userRole === 'Quản trị viên' ? 'bg-warning' : userRole === 'Giảng viên' ? 'bg-info' : 'bg-success'}">${userRole}</span>
          </div>
        </div>
        <div class="col-md-8">
          <table class="table table-borderless">
            <tr>
              <td><strong><i class="bi bi-envelope"></i> Email:</strong></td>
              <td>${userEmail}</td>
            </tr>
            <tr>
              <td><strong><i class="bi bi-calendar"></i> Ngày tham gia:</strong></td>
              <td>${joinDate}</td>
            </tr>
            <tr>
              <td><strong><i class="bi bi-shield-check"></i> Vai trò:</strong></td>
              <td>${userRole}</td>
            </tr>
            <tr>
              <td><strong><i class="bi bi-hash"></i> ID:</strong></td>
              <td><code>${userId}</code></td>
            </tr>
          </table>
        </div>
      </div>
    `;
  }
  
  const modal = new bootstrap.Modal(document.getElementById('userDetailsModal'));
  modal.show();
}

// Không cần filter client-side nữa vì đã dùng server-side filter
</script>
