<h3 class="mb-3">Users</h3>
<div class="mb-3">
  <a href="/admin/users/new-instructor" class="btn btn-primary">+ New Instructor</a>
</div>
<table class="table table-striped">
  <thead><tr><th>Name</th><th>Role</th><th>Email</th><th>Created</th></tr></thead>
  <tbody>
  {{#each users}}
    <tr>
      <td>{{this.name}}</td>
      <td>{{this.role}}</td>
      <td>{{this.email}}</td>
      <td>{{this.created_at}}</td>
    </tr>
  {{/each}}
  </tbody>
</table>
