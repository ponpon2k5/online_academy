<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">Chỉnh sửa danh mục</h3>
  <a href="/admin/categories" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Quay lại
  </a>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <form method="post" action="/admin/categories/{{cat.id}}">
      <div class="mb-3">
        <label class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
        <input 
          name="name" 
          class="form-control" 
          value="{{cat.name}}" 
          placeholder="Nhập tên danh mục..."
          required
          autofocus>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Danh mục cha (tùy chọn)</label>
        <select name="parent_id" class="form-select">
          <option value="">— Không có —</option>
          {{#each parents}}
          <option value="{{id}}" {{#if (eq id ../cat.parent_id)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </div>

      <div class="mb-4">
        <label class="form-label fw-semibold text-muted">Slug</label>
        <input 
          type="text" 
          class="form-control bg-light" 
          value="{{cat.slug}}" 
          disabled>
        <small class="text-muted">Slug được tạo tự động từ tên</small>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-check-circle"></i> Lưu thay đổi
        </button>
        <a href="/admin/categories" class="btn btn-outline-secondary">
          Hủy
        </a>
      </div>
    </form>
  </div>
</div>
