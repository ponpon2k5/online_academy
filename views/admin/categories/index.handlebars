<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">Quản lý danh mục</h3>
  <a class="btn btn-primary" href="/admin/categories/new">
    <i class="bi bi-plus-circle"></i> Thêm danh mục
  </a>
</div>

{{#if categories.length}}
<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th style="width: 80px;">ID</th>
          <th>Tên danh mục</th>
          <th>Slug</th>
          <th>Danh mục cha</th>
          <th style="width: 150px;" class="text-center">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        {{#each categories}}
        <tr>
          <td>
            <span class="badge bg-secondary">#{{id}}</span>
          </td>
          <td>
            <strong>{{name}}</strong>
          </td>
          <td>
            <code class="text-muted small">{{slug}}</code>
          </td>
          <td>
            {{#if parent_name}}
            <span class="badge bg-info">{{parent_name}}</span>
            {{else}}
            <span class="text-muted">—</span>
            {{/if}}
          </td>
          <td class="text-center">
            <div class="d-flex gap-2 justify-content-center">
              <a class="btn btn-sm btn-outline-primary" href="/admin/categories/{{id}}/edit">
                <i class="bi bi-pencil"></i> Sửa
              </a>
              <form action="/admin/categories/{{id}}/delete" method="post" style="display:inline" 
                    onsubmit="return confirm('Bạn có chắc muốn xóa danh mục \"{{name}}\"?');">
                <button class="btn btn-sm btn-outline-danger" type="submit">
                  <i class="bi bi-trash"></i> Xóa
                </button>
              </form>
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
<div class="card shadow-sm">
  <div class="card-body text-center py-5">
    <i class="bi bi-tags display-1 text-muted"></i>
    <h5 class="mt-3 text-muted">Chưa có danh mục nào</h5>
    <a href="/admin/categories/new" class="btn btn-primary mt-3">
      <i class="bi bi-plus-circle"></i> Thêm danh mục đầu tiên
    </a>
  </div>
</div>
{{/if}}
