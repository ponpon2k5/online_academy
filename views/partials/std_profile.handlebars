<div class="container my-5">
    <div class="row g-4">
        <!-- Cột trái: Thông tin học viên + menu -->
        <div class="col-lg-4">
            <!-- Thông tin học viên -->
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="position-relative d-inline-block mb-3">
                        <img src="/images/student/{{authUser.id}}.jpg" class="rounded-circle border shadow-sm"
                            alt="Avatar" style="width:120px;height:120px;object-fit:cover;">
                        <span class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle p-1"
                            style="font-size:0.8rem;">
                        </span>
                    </div>
                    <h5 class="fw-bold mb-0">{{authUser.name}}</h5>
                    <p class="text-muted mb-1 small">{{authUser.email}}</p>
                    <span class="badge bg-info text-dark mb-2">{{authUser.role}}</span>
                    <p class="small text-muted">{{authUser.bio}}</p>
                </div>
            </div>

            <!-- Menu học viên -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header bg-white fw-semibold">
                    <i class="bi bi-person-circle me-2"></i> Tài khoản học viên
                </div>
                <ul class="list-group list-group-flush">
                    <a href="/student/profile-favor-courses"
                        class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="bi bi-heart text-danger me-2"></i> Watchlist (Yêu thích)
                    </a>
                    <a href="/student/profile-purchased-courses"
                        class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="bi bi-bag text-primary me-2"></i> Khóa học đã mua
                    </a>
                    <a href="/student/profile-process-course"
                        class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="bi bi-gear-wide-connected text-success me-2"></i> Tiến độ học tập
                    </a>
                    <a href="/student/profile-edit"
                        class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="bi bi-pencil-square text-secondary me-2"></i> Thay đổi thông tin cá nhân
                    </a>
                </ul>
            </div>
        </div>

        <!-- Cột phải: Danh sách khóa học -->
        <div class="col-lg-8">
            {{> @partial-block}}

            <!-- Phân trang -->
            {{#if pagination}}
            <nav aria-label="Pagination" class="mt-5 mb-5 d-flex justify-content-center">
                <ul class="pagination" style="gap:8px;">

                    {{#if pagination.hasPrev}}
                    <li class="page-item">
                        <a class="page-link" href="?page={{pagination.prevPage}}" aria-label="Previous" style="border:none;border-radius:50%;width:42px;height:42px;
                display:flex;align-items:center;justify-content:center;
                color:#007bff;background:white;
                box-shadow:0 2px 6px rgba(0,0,0,0.1);font-weight:500;">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    {{/if}}

                    {{#each pagination.pages}}
                    <li class="page-item {{#if active}}active{{/if}}">
                        <a class="page-link" href="?page={{number}}" style="border:none;border-radius:50%;width:42px;height:42px;
                display:flex;align-items:center;justify-content:center;
                font-weight:500;
                {{#if active}}
                  background-color:#007bff;color:white;box-shadow:0 0 8px rgba(0,123,255,0.4);
                {{else}}
                  color:#007bff;background:white;
                {{/if}}">
                            {{number}}
                        </a>
                    </li>
                    {{/each}}

                    {{#if pagination.hasNext}}
                    <li class="page-item">
                        <a class="page-link" href="?page={{pagination.nextPage}}" aria-label="Next" style="border:none;border-radius:50%;width:42px;height:42px;
                display:flex;align-items:center;justify-content:center;
                color:#007bff;background:white;
                box-shadow:0 2px 6px rgba(0,0,0,0.1);font-weight:500;">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                    {{/if}}

                </ul>
            </nav>
            {{/if}}

        </div>
    </div>
</div>